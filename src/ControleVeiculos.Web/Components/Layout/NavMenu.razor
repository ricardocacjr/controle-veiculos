@inject AuthState AuthState

@foreach (var item in Items)
{
    <NavLink class="@(Variant == "side" ? "side-link" : "tab-link")" href="@item.Href" Match="NavLinkMatch.Prefix">
        <Icon Name="@item.Icon" Size="@(Variant == "side" ? 20 : 24)" />
        <span>@item.Label</span>
    </NavLink>
}

@code {
    /// <summary>"tab" = barra inferior (celular) | "side" = menu lateral (computador).</summary>
    [Parameter] public string Variant { get; set; } = "tab";

    private record NavItem(string Href, string Icon, string Label);

    // Motorista vê só o próprio fluxo; gestão (Admin/Gestor) vê o cadastro da frota.
    private IEnumerable<NavItem> Items => AuthState.IsInRole("Motorista")
        ? [new("motorista/uso", "car", "Uso"), new("usos", "history", "Histórico")]
        : [new("usos", "clipboard", "Usos"), new("veiculos", "car", "Veículos"), new("motoristas", "users", "Motoristas"), new("empresas", "building", "Empresas")];
}
