@page "/motoristas"
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Motoristas</PageTitle>

<h1 class="page-title">Motoristas</h1>
<p class="page-subtitle">Quem pode registrar uso dos veículos.</p>

@if (AuthState.IsAuthenticated)
{
    <div class="section-title">Novo motorista</div>
    <div class="card-app">
        <EditForm Model="_newDriver" OnValidSubmit="HandleCreateAsync">
            <div class="form-grid">
                <div class="field">
                    <label>Nome</label>
                    <InputText class="form-control" @bind-Value="_newDriver.Nome" />
                </div>
                <div class="field">
                    <label>CNH</label>
                    <InputText class="form-control" @bind-Value="_newDriver.Cnh" inputmode="numeric" />
                </div>
                <div class="field">
                    <label>Telefone</label>
                    <InputText class="form-control" @bind-Value="_newDriver.Telefone" inputmode="tel" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-app mt-3" disabled="@_loading">
                <Icon Name="plus" Size="20" /><span>Adicionar motorista</span>
            </button>
        </EditForm>
    </div>

    <div class="mt-3"><Mensagens Erro="@_error" /></div>

    <div class="section-title">Cadastrados</div>
    @if (_drivers is null)
    {
        <div class="loading-block"><span class="spinner"></span> Carregando...</div>
    }
    else if (_drivers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><Icon Name="users" Size="26" /></div>
            <div>Nenhum motorista cadastrado ainda.</div>
        </div>
    }
    else
    {
        <div class="list-card">
            @foreach (var driver in _drivers)
            {
                <div class="list-item">
                    <span class="avatar">@Iniciais(driver.Nome)</span>
                    <span class="list-item-main">
                        <span class="list-item-title d-block">@driver.Nome</span>
                        <span class="list-item-sub d-block">
                            CNH @driver.Cnh@(driver.CnhValidade is { } v ? $" · válida até {v:dd/MM/yyyy}" : "")@(string.IsNullOrWhiteSpace(driver.Telefone) ? "" : $" · {driver.Telefone}")
                        </span>
                    </span>
                    <span class="list-item-actions">
                        <button class="btn-icon danger" title="Remover" @onclick="() => HandleDeleteAsync(driver)"><Icon Name="trash" Size="18" /></button>
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    private List<ControleVeiculos.Shared.Drivers.DriverDto>? _drivers;
    private string? _error;
    private bool _loading;
    private readonly NewDriverModel _newDriver = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadDriversAsync();
    }

    private async Task LoadDriversAsync()
    {
        try
        {
            _drivers = (await Api.GetDriversAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar os motoristas.";
            _drivers = [];
        }
    }

    private async Task HandleCreateAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var request = new ControleVeiculos.Shared.Drivers.CreateDriverRequest(
                _newDriver.Nome, _newDriver.Cnh, null, _newDriver.Telefone, null);
            await Api.CreateDriverAsync(request);
            _newDriver.Nome = string.Empty;
            _newDriver.Cnh = string.Empty;
            _newDriver.Telefone = null;
            await LoadDriversAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = $"Não foi possível adicionar o motorista: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleDeleteAsync(ControleVeiculos.Shared.Drivers.DriverDto driver)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Remover o motorista {driver.Nome}?");
        if (!confirmado)
            return;

        try
        {
            await Api.DeleteDriverAsync(driver.Id);
            await LoadDriversAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível remover o motorista.";
        }
    }

    private static string Iniciais(string nome) =>
        string.Concat(nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private class NewDriverModel
    {
        public string Nome { get; set; } = string.Empty;
        public string Cnh { get; set; } = string.Empty;
        public string? Telefone { get; set; }
    }
}
