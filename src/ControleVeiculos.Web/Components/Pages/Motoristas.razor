@page "/motoristas"
@using ControleVeiculos.Shared.Auth
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Motoristas</PageTitle>

<h1 class="page-title">Motoristas</h1>
<p class="page-subtitle">Quem aparece na tela de entrada. Cada um entra com a própria foto e PIN de 6 números.</p>

@if (AuthState.IsAuthenticated)
{
    <div class="section-title">Novo motorista</div>
    <div class="card-app">
        <EditForm Model="_novo" OnValidSubmit="CriarAsync">
            <div class="form-grid">
                <div class="field">
                    <label>Nome</label>
                    <InputText class="form-control" @bind-Value="_novo.Nome" placeholder="Ex.: Daniela" />
                </div>
                <div class="field">
                    <label>Usuário</label>
                    <InputText class="form-control" @bind-Value="_novo.Login" autocapitalize="characters" placeholder="Ex.: DANI" />
                </div>
                <div class="field">
                    <label>PIN temporário</label>
                    <InputText class="form-control" @bind-Value="_novo.Pin" inputmode="numeric" maxlength="6" />
                </div>
            </div>
            <div class="field-hint">No primeiro acesso a pessoa digita esse PIN e cria o dela.</div>
            <button type="submit" class="btn btn-primary btn-app mt-3" disabled="@_ocupado">
                <Icon Name="plus" Size="20" /><span>Cadastrar motorista</span>
            </button>
        </EditForm>
    </div>

    <div class="mt-3"><Mensagens Erro="@_erro" Sucesso="@_ok" /></div>

    <div class="section-title">Cadastrados</div>
    @if (_perfis is null)
    {
        <div class="loading-block"><span class="spinner"></span> Carregando...</div>
    }
    else if (_perfis.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><Icon Name="users" Size="26" /></div>
            <div>Nenhum motorista cadastrado ainda.</div>
        </div>
    }
    else
    {
        <div class="list-card">
            @foreach (var p in _perfis)
            {
                <div class="list-item">
                    <CameraGrande Titulo="@($"Trocar a foto de {p.Nome}")" Galeria="true" Recorte="true" LadoMaximo="400"
                                  Url="@($"api/perfis/{p.UserId}/foto")" Metodo="PUT"
                                  OnInicio="() => _erro = _ok = null" OnResultado="r => FotoTrocada(p, r)">
                        <Avatar UserId="p.UserId" Nome="@p.Nome" Versao="@Versao(p)" TemFoto="@(p.TemFoto || _versoes.ContainsKey(p.UserId) ? (bool?)null : false)" Class="list-avatar" />
                    </CameraGrande>
                    <span class="list-item-main">
                        <span class="list-item-title d-block">@p.Nome</span>
                        <span class="list-item-sub d-block" style="white-space:normal">
                            Usuário @p.Login
                            @if (p.PrecisaDefinirPin)
                            {
                                <span class="chip chip-warning ms-1">aguardando 1º acesso</span>
                            }
                            @if (p.EhAdmin)
                            {
                                <span class="chip chip-primary ms-1">Admin</span>
                            }
                        </span>
                    </span>
                    <span class="list-item-actions">
                        <button class="btn-icon" title="Redefinir PIN" @onclick="() => RedefinirPinAsync(p)"><Icon Name="lock" Size="18" /></button>
                        <button class="btn-icon" title="@(p.EhAdmin ? "Tirar Admin" : "Tornar Admin")" @onclick="() => AlternarAdminAsync(p)"><Icon Name="user" Size="18" /></button>
                    </span>
                </div>
            }
        </div>
        <div class="field-hint mt-2">Toque na foto para trocar. 🔒 cria um PIN temporário novo (esqueceu o PIN).</div>
    }
}

<style>
    .list-avatar { width: 46px; height: 46px; border-radius: 14px; font-size: 17px; }
</style>

@code {
    private List<PerfilDto>? _perfis;
    private readonly Dictionary<Guid, string> _versoes = [];
    private string? _erro;
    private string? _ok;
    private bool _ocupado;
    private readonly NovoModel _novo = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await CarregarAsync();
    }

    private string? Versao(PerfilDto p) => _versoes.TryGetValue(p.UserId, out var v) ? v : p.FotoVersao;

    private async Task CarregarAsync()
    {
        try
        {
            _perfis = (await Api.GetPerfisAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível carregar os motoristas.";
            _perfis = [];
        }
    }

    private async Task CriarAsync()
    {
        _ocupado = true;
        _erro = _ok = null;
        try
        {
            var criado = await Api.CriarMotoristaAsync(new CriarMotoristaRequest(_novo.Nome, _novo.Login, _novo.Pin));
            _ok = $"{criado?.Nome} cadastrado. Usuário {criado?.Login}, PIN temporário {_novo.Pin}.";
            _novo.Nome = _novo.Login = "";
            _novo.Pin = "123456";
            await CarregarAsync();
        }
        catch (HttpRequestException ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void FotoTrocada(PerfilDto p, ResultadoEnvio resultado)
    {
        if (!resultado.Ok)
        {
            _erro = $"Não foi possível trocar a foto: {resultado.Mensagem}";
            return;
        }

        _versoes[p.UserId] = DateTimeOffset.UtcNow.ToUnixTimeSeconds().ToString();
        _ok = $"Foto de {p.Nome} atualizada.";
        if (p.UserId == AuthState.UserId)
            AuthState.FotoAlterada();
    }

    private async Task RedefinirPinAsync(PerfilDto p)
    {
        var pin = await JS.InvokeAsync<string?>("prompt", $"PIN temporário para {p.Nome} (6 números):", "123456");
        if (pin is null)
            return;

        _erro = _ok = null;
        try
        {
            await Api.RedefinirPinAsync(p.UserId, pin.Trim());
            _ok = $"PIN de {p.Nome} redefinido para {pin.Trim()}. No próximo acesso ele(a) cria um novo.";
            await CarregarAsync();
        }
        catch (HttpRequestException ex)
        {
            _erro = ex.Message;
        }
    }

    private async Task AlternarAdminAsync(PerfilDto p)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm", p.EhAdmin
            ? $"Tirar o acesso de administrador de {p.Nome}?"
            : $"Tornar {p.Nome} administrador? Ele(a) poderá cadastrar motoristas, veículos e ver todos os usos.");
        if (!confirmar)
            return;

        _erro = _ok = null;
        try
        {
            await Api.DefinirAdminAsync(p.UserId, !p.EhAdmin);
            _ok = p.EhAdmin ? $"{p.Nome} não é mais administrador." : $"{p.Nome} agora é administrador (vale no próximo login).";
            await CarregarAsync();
        }
        catch (HttpRequestException ex)
        {
            _erro = ex.Message;
        }
    }

    private class NovoModel
    {
        public string Nome { get; set; } = "";
        public string Login { get; set; } = "";
        public string Pin { get; set; } = "123456";
    }
}
