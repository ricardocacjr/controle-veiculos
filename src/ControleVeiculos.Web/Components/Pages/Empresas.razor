@page "/empresas"
@using ControleVeiculos.Shared.Empresas
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Empresas</PageTitle>

<h1 class="page-title">Empresas</h1>
<p class="page-subtitle">Para quem cada uso do veículo é feito.</p>

@if (AuthState.IsAuthenticated)
{
    <div class="section-title">@(_editingId is null ? "Nova empresa" : "Editar empresa")</div>
    <div class="card-app">
        <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
            <div class="field">
                <label>Nome</label>
                <InputText class="form-control" @bind-Value="_form.Nome" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-app" disabled="@_loading">
                    <Icon Name="@(_editingId is null ? "plus" : "check")" Size="20" /><span>@(_editingId is null ? "Adicionar empresa" : "Salvar alterações")</span>
                </button>
                @if (_editingId is not null)
                {
                    <button type="button" class="btn btn-soft btn-app" style="max-width:140px" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>

    <div class="mt-3"><Mensagens Erro="@_error" /></div>

    <div class="section-title">Cadastradas</div>
    @if (_empresas is null)
    {
        <div class="loading-block"><span class="spinner"></span> Carregando...</div>
    }
    else if (_empresas.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><Icon Name="building" Size="26" /></div>
            <div>Nenhuma empresa cadastrada ainda.</div>
        </div>
    }
    else
    {
        <div class="list-card">
            @foreach (var empresa in _empresas)
            {
                <div class="list-item">
                    <span class="avatar tone-violet"><Icon Name="building" Size="20" /></span>
                    <span class="list-item-main">
                        <span class="list-item-title d-block">@empresa.Nome</span>
                    </span>
                    <span class="list-item-actions">
                        <button class="btn-icon" title="Editar" @onclick="() => StartEdit(empresa)"><Icon Name="pencil" Size="18" /></button>
                        <button class="btn-icon danger" title="Remover" @onclick="() => HandleDeleteAsync(empresa)"><Icon Name="trash" Size="18" /></button>
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    private List<EmpresaDto>? _empresas;
    private string? _error;
    private bool _loading;
    private Guid? _editingId;
    private readonly EmpresaFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadEmpresasAsync();
    }

    private async Task LoadEmpresasAsync()
    {
        try
        {
            _empresas = (await Api.GetEmpresasAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar as empresas.";
            _empresas = [];
        }
    }

    private void StartEdit(EmpresaDto empresa)
    {
        _editingId = empresa.Id;
        _form.Nome = empresa.Nome;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        ResetForm();
    }

    private async Task HandleSubmitAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_editingId is { } id)
            {
                await Api.UpdateEmpresaAsync(id, new UpdateEmpresaRequest(_form.Nome));
                _editingId = null;
            }
            else
            {
                await Api.CreateEmpresaAsync(new CreateEmpresaRequest(_form.Nome));
            }

            ResetForm();
            await LoadEmpresasAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = $"Não foi possível salvar a empresa: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleDeleteAsync(EmpresaDto empresa)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Remover a empresa {empresa.Nome}?");
        if (!confirmado)
            return;

        try
        {
            await Api.DeleteEmpresaAsync(empresa.Id);
            await LoadEmpresasAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível remover a empresa.";
        }
    }

    private void ResetForm()
    {
        _form.Nome = string.Empty;
    }

    private class EmpresaFormModel
    {
        public string Nome { get; set; } = string.Empty;
    }
}
