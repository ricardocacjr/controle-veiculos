@page "/usos"
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>@Titulo</PageTitle>

@if (_ehMotorista)
{
    <a class="back-link text-decoration-none" href="motorista/uso"><Icon Name="chevron-left" Size="18" /> Voltar</a>
}
<h1 class="page-title">@Titulo</h1>
<p class="page-subtitle">@(_ehMotorista ? "Suas saídas com o veículo." : "Todas as saídas registradas pelos motoristas.")</p>

@if (_error is not null)
{
    <Mensagens Erro="@_error" />
}
else if (_usos is null)
{
    <div class="loading-block"><span class="spinner"></span> Carregando...</div>
}
else if (_usos.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><Icon Name="history" Size="26" /></div>
        <div>Nenhum uso registrado ainda.</div>
    </div>
}
else
{
    <div class="list-card">
        @foreach (var uso in _usos)
        {
            var status = Rotulos.Uso(uso.Status);
            <a class="list-item" href="@($"usos/{uso.Id}")">
                <span class="avatar"><Icon Name="car" Size="20" /></span>
                <span class="list-item-main">
                    <span class="list-item-title d-block">@uso.Finalidade</span>
                    <span class="list-item-sub d-block">@Subtitulo(uso)</span>
                    <span class="list-item-sub d-block">@Quilometragem(uso)</span>
                </span>
                <span class="chip @status.Chip">@status.Texto</span>
                <Icon Name="chevron-right" Size="18" Class="muted" />
            </a>
        }
    </div>
}

<Mensagens Sucesso="@_ok" />

@if (AuthState.IsInRole("Admin") && !_ehMotorista && _usos is { Count: > 0 })
{
    <div class="zona-perigo">
        @if (!_confirmandoZerar)
        {
            <button type="button" class="btn btn-soft btn-app" @onclick="AbrirZerar">
                <Icon Name="trash" Size="18" /><span>Zerar todos os usos</span>
            </button>
            <div class="field-hint text-center mt-2">Para começar do zero depois de treinar a equipe.</div>
        }
        else
        {
            <div class="card-app zerar-card">
                <div class="zerar-titulo"><Icon Name="alert" Size="22" /> Apagar as @_usos.Count saídas?</div>
                <p class="mb-2">Some <b>tudo</b> do histórico: saídas, fotos, áudios e abastecimentos. <b>Não dá pra desfazer.</b></p>
                <p class="muted mb-3" style="font-size:14px">Ficam: motoristas e PINs, veículos (com o km atual), empresas e motivos.</p>
                <label class="fw-bold mb-1">Para confirmar, digite <span class="zerar-palavra">ZERAR</span></label>
                <input class="form-control" @bind="_confirmacao" @bind:event="oninput" autocapitalize="characters" autocomplete="off" placeholder="ZERAR" />
                <Mensagens Erro="@_erroZerar" />
                <div class="zerar-acoes mt-3">
                    <button type="button" class="btn btn-soft btn-app" disabled="@_zerando" @onclick="() => _confirmandoZerar = false">Cancelar</button>
                    <button type="button" class="btn btn-danger btn-app" disabled="@(_zerando || !ConfirmacaoOk)" @onclick="ZerarAsync">
                        @if (_zerando)
                        {
                            <span class="spinner"></span><span>Apagando...</span>
                        }
                        else
                        {
                            <span>Apagar tudo</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool _confirmandoZerar;
    private string? _confirmacao;
    private bool _zerando;
    private string? _erroZerar;
    private string? _ok;

    private bool ConfirmacaoOk => string.Equals(_confirmacao?.Trim(), "ZERAR", StringComparison.OrdinalIgnoreCase);

    private void AbrirZerar()
    {
        _confirmandoZerar = true;
        _confirmacao = null;
        _erroZerar = null;
        _ok = null;
    }

    private async Task ZerarAsync()
    {
        _zerando = true;
        _erroZerar = null;
        try
        {
            var apagadas = await Api.ZerarUsosAsync(_confirmacao ?? "");
            _confirmandoZerar = false;
            _usos = [];
            _ok = $"Pronto! {apagadas} saída(s) apagada(s). O histórico começa do zero.";
        }
        catch (HttpRequestException ex)
        {
            _erroZerar = ex.Message;
        }
        finally
        {
            _zerando = false;
        }
    }

    private List<ControleVeiculos.Shared.UsageRecords.UsageRecordDto>? _usos;
    private string? _error;
    private bool _ehMotorista;

    private string Titulo => _ehMotorista ? "Minhas saídas" : "Usos registrados";

    private string Subtitulo(ControleVeiculos.Shared.UsageRecords.UsageRecordDto uso)
    {
        var partes = new List<string> { uso.VeiculoPlaca };
        if (!_ehMotorista) partes.Add(uso.MotoristaNome);
        if (uso.EmpresaNome is not null) partes.Add(uso.EmpresaNome);
        partes.Add(Rotulos.DataHora(uso.IniciadoEm));
        return string.Join(" · ", partes);
    }

    private static string Quilometragem(ControleVeiculos.Shared.UsageRecords.UsageRecordDto uso) =>
        uso.OdometroFinal is { } fim
            ? $"{Rotulos.Km(uso.OdometroInicial)} → {Rotulos.Km(fim)} · {fim - uso.OdometroInicial:N0} km rodados"
            : $"Saída com {Rotulos.Km(uso.OdometroInicial)}";

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Ricardo é motorista e admin: na lista geral (administração) ele vê todos.
        _ehMotorista = AuthState.EhMotorista && !AuthState.EhGestao;
        try
        {
            _usos = (await Api.GetUsageRecordsAsync()).OrderByDescending(u => u.IniciadoEm).ToList();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar os usos registrados.";
        }
    }
}
