@page "/relatorios"
@using ControleVeiculos.Shared.Relatorios
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Relatórios</PageTitle>

<h1 class="page-title">Relatórios</h1>
<p class="page-subtitle">Quanto os veículos rodaram, com quem, para qual empresa e quanto custou.</p>

<div class="periodo-chips">
    @foreach (var (chave, texto) in Atalhos)
    {
        <button type="button" class="periodo-chip @(_atalho == chave ? "ativo" : "")" @onclick="() => EscolherAsync(chave)">@texto</button>
    }
</div>

@if (_atalho == "datas")
{
    <div class="card-app periodo-datas">
        <div class="field mb-0">
            <label>De</label>
            <input type="date" class="form-control" @bind="_deEscolhido" />
        </div>
        <div class="field mb-0">
            <label>Até</label>
            <input type="date" class="form-control" @bind="_ateEscolhido" />
        </div>
        <button type="button" class="btn btn-primary" @onclick="AplicarDatasAsync">Ver</button>
    </div>
}

<div class="periodo-linha">
    <span class="muted">@_de.ToString("dd/MM/yyyy") a @_ate.ToString("dd/MM/yyyy")</span>
    <button type="button" class="btn btn-soft" disabled="@(_baixando || _rel is null)" @onclick="BaixarAsync">
        @if (_baixando)
        {
            <span class="spinner"></span><span>Gerando...</span>
        }
        else
        {
            <Icon Name="download" Size="18" /><span>Baixar planilha (Excel)</span>
        }
    </button>
</div>

<Mensagens Erro="@_erro" />

@if (_carregando)
{
    <div class="loading-block"><span class="spinner"></span> Calculando...</div>
}
else if (_rel is { } rel)
{
    var r = rel.Resumo;
    <div class="kpi-grid">
        <div class="kpi">
            <div class="kpi-icone tone-primary"><Icon Name="clipboard" Size="20" /></div>
            <div class="kpi-valor">@r.Saidas</div>
            <div class="kpi-rotulo">saídas</div>
            @if (r.EmAndamento > 0)
            {
                <div class="kpi-extra">@r.EmAndamento em andamento</div>
            }
        </div>
        <div class="kpi">
            <div class="kpi-icone tone-accent"><Icon Name="gauge" Size="20" /></div>
            <div class="kpi-valor">@r.KmRodados.ToString("N0")</div>
            <div class="kpi-rotulo">km rodados</div>
        </div>
        <div class="kpi">
            <div class="kpi-icone tone-violet"><Icon Name="clock" Size="20" /></div>
            <div class="kpi-valor">@Horas(r.Horas)</div>
            <div class="kpi-rotulo">horas de uso</div>
        </div>
        <div class="kpi">
            <div class="kpi-icone tone-success"><Icon Name="fuel" Size="20" /></div>
            <div class="kpi-valor">@r.GastoCombustivel.ToString("C0")</div>
            <div class="kpi-rotulo">em combustível</div>
            <div class="kpi-extra">@r.Litros.ToString("N1") L · @r.Abastecimentos abastec.</div>
            @if (r.PagoPelosMotoristas > 0)
            {
                <div class="kpi-extra">@r.PagoPelosMotoristas.ToString("C") pago pelos motoristas</div>
            }
        </div>
    </div>

    var cu = rel.Custos;
    <div class="section-title d-flex justify-content-between align-items-center">
        <span>Custos e cobrança</span>
        <a class="link-secao" href="custos">⚙ Custos e tarifa</a>
    </div>
    <div class="card-app">
        <div class="custo-linha">
            <span>Combustível por km@(cu.KmPorLitro is { } kml ? $" ({kml:N1} km/L)" : "")</span>
            <b>@(cu.CombustivelPorKm?.ToString("C4") ?? "—")</b>
        </div>
        <div class="custo-linha"><span>Pneus + manutenção por km</span><b>@cu.ExtraPorKm.ToString("C4")</b></div>
        <div class="custo-linha total"><span>Custo real do km</span><b>@(cu.CustoTotalPorKm?.ToString("C4") ?? "—")</b></div>
        <div class="custo-linha"><span>Tarifa cobrada por km</span><b>@cu.TarifaPorKm.ToString("C4")</b></div>
        @if (cu.CombustivelPorKm is null)
        {
            <div class="field-hint mt-2">O combustível por km aparece depois de dois abastecimentos de tanque cheio.</div>
        }
        else if (cu.OrigemCombustivel is { } origem && origem.StartsWith("últimos"))
        {
            <div class="field-hint mt-2">Nenhum tanque cheio fechou neste período — usando os últimos ciclos.</div>
        }
        @if (cu.CustoTotalPorKm is { } ck && ck > cu.TarifaPorKm)
        {
            <div class="notice notice-error mt-3 mb-0">O km está custando @ck.ToString("C4") e a tarifa é @cu.TarifaPorKm.ToString("C4"). Vale revisar a tarifa em "Custos e tarifa".</div>
        }
    </div>

    @if (rel.PorEmpresa.Count > 0)
    {
        <div class="table-card mt-3">
            <table class="table consumo-tabela">
                <thead>
                    <tr>
                        <th>Categoria</th>
                        <th class="text-end">Km</th>
                        <th class="text-end">%</th>
                        <th class="text-end">Custo real</th>
                        <th class="text-end">A cobrar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in rel.PorEmpresa)
                    {
                        <tr>
                            <td>@g.Nome</td>
                            <td class="text-end">@g.KmRodados.ToString("N0")</td>
                            <td class="text-end">@g.PercentualKm.ToString("N0")%</td>
                            <td class="text-end">@g.CustoReal.ToString("C")</td>
                            <td class="text-end fw-bold">
                                @g.ValorACobrar.ToString("C")
                                @if (g.PagoPeloMotorista > 0)
                                {
                                    <div class="muted" style="font-size:12px;font-weight:500">já descontado @g.PagoPeloMotorista.ToString("C") pago do bolso</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="fw-bold">Total</td>
                        <td class="text-end fw-bold">@r.KmRodados.ToString("N0")</td>
                        <td></td>
                        <td class="text-end fw-bold">@cu.CustoReal.ToString("C")</td>
                        <td class="text-end fw-bold">@cu.ValorACobrar.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="field-hint mt-2">A cobrar = km × tarifa, menos o combustível que o motorista pagou do bolso naquela saída.</div>
    }

    <div class="section-title">Alertas (@rel.Alertas.Count)</div>
    @if (rel.Alertas.Count == 0)
    {
        <div class="notice notice-success">Nenhum alerta no período. ✅</div>
    }
    else
    {
        <div class="list-card">
            @foreach (var a in _todosAlertas ? rel.Alertas : rel.Alertas.Take(5))
            {
                var (chip, texto) = Gravidade(a.Gravidade);
                <a class="list-item alerta-item" href="@(a.UsoId is { } id ? $"usos/{id}" : null)">
                    <span class="list-item-main">
                        <span class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="chip @chip">@texto</span>
                            <span class="list-item-title">@a.Tipo</span>
                        </span>
                        <span class="list-item-sub d-block alerta-texto">@a.Descricao</span>
                    </span>
                    @if (a.UsoId is not null)
                    {
                        <Icon Name="chevron-right" Size="18" Class="muted" />
                    }
                </a>
            }
        </div>
        @if (rel.Alertas.Count > 5)
        {
            <button type="button" class="link-discreto border-0 bg-transparent w-100" @onclick="() => _todosAlertas = !_todosAlertas">
                @(_todosAlertas ? "Mostrar menos" : $"Ver todos os {rel.Alertas.Count} alertas")
            </button>
        }
    }

    <div class="section-title">Quem, para quem e por quê</div>
    <div class="seg">
        @foreach (var (chave, texto) in Visoes)
        {
            <button type="button" class="seg-btn @(_visao == chave ? "ativo" : "")" @onclick="() => _visao = chave">@texto</button>
        }
    </div>
    var grupos = _visao switch { "empresa" => rel.PorEmpresa, "motivo" => rel.PorMotivo, _ => rel.PorMotorista };
    var porKm = grupos.Any(g => g.KmRodados > 0);
    var maximo = Math.Max(1, grupos.Count == 0 ? 1 : grupos.Max(g => porKm ? g.KmRodados : g.Saidas));
    var totalKm = Math.Max(1, grupos.Sum(g => g.KmRodados));
    @if (grupos.Count == 0)
    {
        <div class="empty-state"><div>Nenhuma saída no período.</div></div>
    }
    else
    {
        <div class="card-app barras">
            @foreach (var g in grupos)
            {
                var valor = porKm ? g.KmRodados : g.Saidas;
                <div class="barra-linha">
                    <div class="barra-topo">
                        <span class="barra-nome">@g.Nome</span>
                        <span class="barra-valor">
                            @if (porKm)
                            {
                                @($"{g.KmRodados:N0} km") <small class="muted">(@((100.0 * g.KmRodados / totalKm).ToString("N0"))%)</small>
                            }
                            else
                            {
                                @($"{g.Saidas} saída(s)")
                            }
                        </span>
                    </div>
                    <div class="barra-trilho"><div class="barra-cheia" style="width:@((100.0 * valor / maximo).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                    <div class="barra-meta">@g.Saidas saída(s) · @Horas(g.Horas) h@(g.ValorACobrar > 0 ? $" · a cobrar {g.ValorACobrar:C}" : "")</div>
                </div>
            }
        </div>
    }

    <div class="section-title">Tanque cheio a tanque cheio</div>
    @if (rel.Ciclos.Count == 0)
    {
        <div class="empty-state"><div>Nenhum tanque cheio fechado no período. O primeiro tanque cheio só marca o ponto de partida.</div></div>
    }
    else
    {
        <div class="list-card">
            @foreach (var c in rel.Ciclos)
            {
                <div class="list-item">
                    <span class="avatar"><Icon Name="fuel" Size="20" /></span>
                    <span class="list-item-main">
                        <span class="list-item-title d-block">@(c.KmPorLitro?.ToString("N1") ?? "—") km/L · @(c.CustoPorKm?.ToString("C3") ?? "—")/km</span>
                        <span class="list-item-sub d-block" style="white-space:normal">
                            @Rotulos.DataHora(c.Inicio) → @Rotulos.DataHora(c.Fim) · @c.Km.ToString("N0") km · @c.Litros.ToString("N3") L · @c.Gasto.ToString("C")
                        </span>
                    </span>
                </div>
            }
        </div>
        <div class="field-hint mt-2">Km rodados entre dois tanques cheios ÷ litros postos para encher de novo = consumo real do carro.</div>
    }

    <div class="section-title">Consumo (últimos 12 meses)</div>
    @if (rel.Consumo.Count == 0)
    {
        <div class="empty-state"><div>Ainda sem dados de consumo.</div></div>
    }
    else
    {
        var variosVeiculos = rel.Consumo.Select(c => c.Veiculo).Distinct().Count() > 1;
        <div class="table-card">
            <table class="table consumo-tabela">
                <thead>
                    <tr>
                        <th>Mês</th>
                        @if (variosVeiculos)
                        {
                            <th>Veículo</th>
                        }
                        <th class="text-end">Km</th>
                        <th class="text-end">Litros</th>
                        <th class="text-end">Km/L</th>
                        <th class="text-end">R$/km</th>
                        <th class="text-end">R$/litro</th>
                        <th class="text-end">Gasto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in rel.Consumo)
                    {
                        <tr>
                            <td class="text-nowrap">@NomeMes(c.Ano, c.Mes)</td>
                            @if (variosVeiculos)
                            {
                                <td class="text-nowrap">@c.Veiculo</td>
                            }
                            <td class="text-end">@c.KmRodados.ToString("N0")</td>
                            <td class="text-end">@c.Litros.ToString("N1")</td>
                            <td class="text-end fw-bold">@(c.KmPorLitro?.ToString("N1") ?? "—")</td>
                            <td class="text-end">@(c.CustoPorKm?.ToString("C") ?? "—")</td>
                            <td class="text-end">@(c.PrecoMedioLitro?.ToString("N2") ?? "—")</td>
                            <td class="text-end text-nowrap">@c.Gasto.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="field-hint mt-2">Km/L e R$/km pelos ciclos de tanque cheio que fecharam no mês (— = nenhum ciclo fechou).</div>
    }
}

@code {
    private static readonly (string Chave, string Texto)[] Atalhos =
    [
        ("semana", "Esta semana"), ("semana-passada", "Semana passada"), ("mes", "Este mês"), ("anterior", "Mês passado"),
        ("30", "Últimos 30 dias"), ("ano", "Este ano"), ("datas", "Escolher datas"),
    ];

    private static readonly (string Chave, string Texto)[] Visoes =
    [
        ("motorista", "Motorista"), ("empresa", "Empresa"), ("motivo", "Motivo"),
    ];

    private string _atalho = "mes";
    private string _visao = "motorista";
    private DateOnly _de;
    private DateOnly _ate;
    private DateOnly _deEscolhido;
    private DateOnly _ateEscolhido;
    private RelatorioDto? _rel;
    private bool _carregando;
    private bool _baixando;
    private bool _todosAlertas;
    private string? _erro;

    private static DateOnly Hoje => DateOnly.FromDateTime(Rotulos.Local(DateTimeOffset.UtcNow).DateTime);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated || !AuthState.EhGestao)
        {
            Nav.NavigateTo("/");
            return;
        }

        _deEscolhido = Hoje.AddDays(-29);
        _ateEscolhido = Hoje;
        await EscolherAsync("mes");
    }

    private async Task EscolherAsync(string atalho)
    {
        _atalho = atalho;
        var hoje = Hoje;
        var inicioMes = new DateOnly(hoje.Year, hoje.Month, 1);
        (DateOnly De, DateOnly Ate)? periodo = atalho switch
        {
            "mes" => (inicioMes, hoje),
            "anterior" => (inicioMes.AddMonths(-1), inicioMes.AddDays(-1)),
            "semana" => (InicioSemana(hoje), hoje),
            "semana-passada" => (InicioSemana(hoje).AddDays(-7), InicioSemana(hoje).AddDays(-1)),
            "30" => (hoje.AddDays(-29), hoje),
            "ano" => (new DateOnly(hoje.Year, 1, 1), hoje),
            _ => null, // "datas": espera a pessoa escolher e tocar em "Ver"
        };
        if (periodo is { } p)
            await CarregarAsync(p.De, p.Ate);
    }

    private async Task AplicarDatasAsync()
    {
        _erro = null;
        if (_ateEscolhido < _deEscolhido)
        {
            _erro = "A data final precisa ser depois da inicial.";
            return;
        }
        await CarregarAsync(_deEscolhido, _ateEscolhido);
    }

    private async Task CarregarAsync(DateOnly de, DateOnly ate)
    {
        _de = de;
        _ate = ate;
        _carregando = true;
        _erro = null;
        _todosAlertas = false;
        try
        {
            _rel = await Api.GetRelatorioAsync(de, ate);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _rel = null;
            _erro = "Não foi possível gerar o relatório. Tente de novo.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task BaixarAsync()
    {
        _baixando = true;
        _erro = null;
        try
        {
            var nome = $"relatorio-veiculos-{_de:yyyy-MM-dd}-a-{_ate:yyyy-MM-dd}.xlsx";
            _erro = await JS.InvokeAsync<string?>("cvBaixar", Api.RelatorioExcelUrl(_de, _ate), AuthState.Token, nome);
        }
        catch (JSException)
        {
            _erro = "Não consegui baixar a planilha. Tente de novo.";
        }
        finally
        {
            _baixando = false;
        }
    }

    private static string Horas(double horas) => horas.ToString(horas >= 100 ? "N0" : "N1");

    /// <summary>Semana começa na segunda-feira.</summary>
    private static DateOnly InicioSemana(DateOnly dia) => dia.AddDays(-(((int)dia.DayOfWeek + 6) % 7));

    private static string NomeMes(int ano, int mes) =>
        new DateTime(ano, mes, 1).ToString("MMM/yy").TrimEnd('.').Replace("./", "/");

    private static (string Chip, string Texto) Gravidade(GravidadeAlerta g) => g switch
    {
        GravidadeAlerta.Alta => ("chip-danger", "Atenção"),
        GravidadeAlerta.Media => ("chip-warning", "Conferir"),
        _ => ("chip-primary", "Info"),
    };
}
