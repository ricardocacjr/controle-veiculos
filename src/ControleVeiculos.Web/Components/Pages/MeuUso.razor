@page "/motorista/uso"
@using ControleVeiculos.Shared.UsageRecords
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Uso do veículo</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    return;
}

@if (_finalizado is not null)
{
    <div class="success-screen">
        <div class="success-icon"><Icon Name="check" Size="52" StrokeWidth="2.6" /></div>
        <h1>Uso finalizado!</h1>
        <p>@_finalizado<br />Obrigado, @AuthState.PrimeiroNome.</p>
        <button type="button" class="btn btn-primary btn-app big mt-3" @onclick="NovaSaidaAsync">Voltar ao início</button>
    </div>
}
else if (_carregando)
{
    <div class="loading-block"><span class="spinner"></span> Carregando...</div>
}
else if (_erro is not null)
{
    <Mensagens Erro="@_erro" />
    <button class="btn btn-soft btn-app" @onclick="CarregarAsync">Tentar de novo</button>
}
else if (_usoAtual is null)
{
    <NovaSaida OnIniciado="IniciadoAsync" />
}
else
{
    <EmUso @key="_usoAtual.Id" Uso="_usoAtual" AvisoInicial="@_aviso" OnFinalizado="Finalizado" />
}

@code {
    private bool _carregando = true;
    private string? _erro;
    private string? _aviso;
    private string? _finalizado;
    private UsageRecordDto? _usoAtual;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        if (AuthState.PrecisaDefinirPin)
        {
            Nav.NavigateTo("/primeiro-acesso");
            return;
        }

        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _erro = null;
        try
        {
            _usoAtual = await Api.GetUsoAtualAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // Sessão salva expirou/foi revogada — volta pra escolha de perfil.
            await AuthState.SairAsync();
            Nav.NavigateTo("/login");
        }
        catch (HttpRequestException ex)
        {
            _erro = $"Não foi possível carregar: {ex.Message}";
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task IniciadoAsync()
    {
        _aviso = "🚗 Saída registrada. Boa viagem!";
        await CarregarAsync();
    }

    private void Finalizado(string resumo)
    {
        _finalizado = resumo;
        _usoAtual = null;
    }

    private async Task NovaSaidaAsync()
    {
        _finalizado = null;
        _aviso = null;
        await CarregarAsync();
    }
}
