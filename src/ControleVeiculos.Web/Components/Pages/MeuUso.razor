@page "/motorista/uso"
@using ControleVeiculos.Domain.Enums
@using ControleVeiculos.Shared.Empresas
@using ControleVeiculos.Shared.UsageRecords
@using ControleVeiculos.Shared.Vehicles
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Meu uso do veículo</PageTitle>

<h1>Uso do veículo</h1>

@if (!AuthState.IsAuthenticated)
{
    <p>Você precisa <a href="/login">entrar</a> (com uma conta Motorista) pra registrar um uso.</p>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_loading)
{
    <p>Carregando...</p>
}
else if (_usoAtual is null)
{
    <h2>Iniciar uso</h2>

    <div class="mb-3" style="max-width:400px">
        <label class="form-label small mb-0 d-block">📷 Foto do painel (opcional — preenche odômetro e origem automaticamente)</label>
        <InputFile OnChange="HandlePainelPhotoSelectedAsync" accept="image/*" capture="environment" disabled="@_lendoPainel" />
        @if (_lendoPainel)
        {
            <div class="form-text">Lendo foto...</div>
        }
    </div>

    <EditForm Model="_startForm" OnValidSubmit="HandleIniciarAsync">
        <div class="mb-2" style="max-width:400px">
            <label class="form-label small mb-0">Veículo</label>
            <InputSelect class="form-select" @bind-Value="_startForm.VeiculoId">
                <option value="">Selecione...</option>
                @foreach (var v in _veiculosDisponiveis)
                {
                    <option value="@v.Id">@v.Placa — @v.Marca @v.Modelo</option>
                }
            </InputSelect>
        </div>
        <div class="mb-2" style="max-width:400px">
            <label class="form-label small mb-0">Empresa</label>
            <InputSelect class="form-select" @bind-Value="_startForm.EmpresaId">
                <option value="">(nenhuma)</option>
                @foreach (var emp in _empresas)
                {
                    <option value="@emp.Id">@emp.Nome</option>
                }
            </InputSelect>
        </div>
        <div class="mb-2" style="max-width:400px">
            <label class="form-label small mb-0">Finalidade</label>
            <InputText class="form-control" @bind-Value="_startForm.Finalidade" list="motivos-datalist" autocomplete="off" />
            <datalist id="motivos-datalist">
                @foreach (var motivo in _motivos)
                {
                    <option value="@motivo.Nome" />
                }
            </datalist>
            <div class="form-text">Digite um motivo novo se não achar na lista — ele fica salvo pra próxima vez.</div>
        </div>
        <div class="mb-2" style="max-width:400px">
            <label class="form-label small mb-0">Origem</label>
            <InputText class="form-control" @bind-Value="_startForm.Origem" />
        </div>
        <div class="mb-2" style="max-width:400px">
            <label class="form-label small mb-0">Destino</label>
            <InputText class="form-control" @bind-Value="_startForm.Destino" />
        </div>
        <div class="mb-3" style="max-width:400px">
            <label class="form-label small mb-0">Odômetro inicial</label>
            <InputNumber class="form-control" @bind-Value="_startForm.OdometroInicial" />
        </div>

        @if (_actionError is not null)
        {
            <div class="alert alert-danger">@_actionError</div>
        }
        @if (_actionStatus is not null)
        {
            <div class="alert alert-success">@_actionStatus</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@_submitting">Iniciar uso</button>
    </EditForm>
}
else
{
    <div class="card mb-3" style="max-width:500px">
        <div class="card-body">
            <h5 class="card-title">@_usoAtual.VeiculoPlaca — @_usoAtual.Finalidade</h5>
            @if (_usoAtual.EmpresaNome is not null)
            {
                <p class="card-text mb-1"><strong>Empresa:</strong> @_usoAtual.EmpresaNome</p>
            }
            <p class="card-text mb-1">@(_usoAtual.Origem ?? "-") → @(_usoAtual.Destino ?? "-")</p>
            <p class="card-text mb-1">Odômetro inicial: @_usoAtual.OdometroInicial km</p>
            <p class="card-text text-muted">Iniciado em @_usoAtual.IniciadoEm.LocalDateTime</p>
        </div>
    </div>

    @if (_actionError is not null)
    {
        <div class="alert alert-danger">@_actionError</div>
    }
    @if (_actionStatus is not null)
    {
        <div class="alert alert-success">@_actionStatus</div>
    }

    <h2>📷 Fotos</h2>
    <div class="mb-3 d-flex flex-wrap gap-3 align-items-end">
        <div>
            <label class="form-label small mb-0 d-block">Odômetro</label>
            <InputFile OnChange="@(e => HandlePhotoSelectedAsync(e, VehiclePhotoType.OdometroFinal))" accept="image/*" capture="environment" disabled="@_uploadingPhoto" />
        </div>
        <div>
            <label class="form-label small mb-0 d-block">Avaria</label>
            <InputFile OnChange="@(e => HandlePhotoSelectedAsync(e, VehiclePhotoType.Avaria))" accept="image/*" capture="environment" disabled="@_uploadingPhoto" />
        </div>
    </div>

    <h2>🎙️ Nota de voz</h2>
    <div class="mb-3">
        <InputFile OnChange="HandleVoiceNoteSelectedAsync" accept="audio/*" capture="user" disabled="@_uploadingVoice" />
        <div class="form-text">No iPhone/Android, isso abre a gravação de áudio direto do navegador.</div>
    </div>

    <h2>⛽ Abastecimento</h2>
    <div class="mb-2" style="max-width:400px">
        <label class="form-label small mb-0 d-block">📷 Foto da nota fiscal ou cupom (opcional — preenche litros e valores automaticamente)</label>
        <InputFile OnChange="HandleReceiptPhotoSelectedAsync" accept="image/*" capture="environment" disabled="@_lendoComprovante" />
        @if (_lendoComprovante)
        {
            <div class="form-text">Lendo comprovante...</div>
        }
    </div>
    <EditForm Model="_fuelForm" OnValidSubmit="HandleFuelAsync">
        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
            <div style="width:100px">
                <label class="form-label small mb-0">Litros</label>
                <InputNumber class="form-control" @bind-Value="_fuelForm.Litros" />
            </div>
            <div style="width:120px">
                <label class="form-label small mb-0">Valor total (R$)</label>
                <InputNumber class="form-control" @bind-Value="_fuelForm.ValorTotal" />
            </div>
            <div style="width:110px">
                <label class="form-label small mb-0">Valor/litro (R$)</label>
                <InputNumber class="form-control" @bind-Value="_fuelForm.ValorPorLitro" />
            </div>
            <div style="width:110px">
                <label class="form-label small mb-0">Odômetro</label>
                <InputNumber class="form-control" @bind-Value="_fuelForm.Odometro" />
            </div>
            <button type="submit" class="btn btn-outline-primary" disabled="@_submitting">Registrar</button>
        </div>
    </EditForm>

    @if (_detalhe is not null)
    {
        <h2>Anexado até agora</h2>
        <ul>
            <li>Fotos: @_detalhe.Fotos.Count</li>
            <li>Notas de voz: @_detalhe.NotasDeVoz.Count</li>
            <li>Abastecimentos: @_detalhe.Abastecimentos.Count</li>
        </ul>
    }

    <h2>🏁 Finalizar uso</h2>
    <EditForm Model="_finishForm" OnValidSubmit="HandleFinalizarAsync">
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div style="width:130px">
                <label class="form-label small mb-0">Odômetro final</label>
                <InputNumber class="form-control" @bind-Value="_finishForm.OdometroFinal" />
            </div>
            <button type="submit" class="btn btn-danger" disabled="@_submitting">Finalizar uso</button>
        </div>
    </EditForm>
}

@code {
    private bool _loading = true;
    private bool _submitting;
    private bool _uploadingPhoto;
    private bool _uploadingVoice;
    private bool _lendoPainel;
    private bool _lendoComprovante;
    private string? _loadError;
    private string? _actionError;
    private string? _actionStatus;
    private UsageRecordDto? _usoAtual;
    private UsageRecordDetailDto? _detalhe;
    private List<VehicleDto> _veiculosDisponiveis = [];
    private List<EmpresaDto> _empresas = [];
    private List<MotivoUsoDto> _motivos = [];
    private readonly StartForm _startForm = new();
    private readonly FuelForm _fuelForm = new();
    private readonly FinishForm _finishForm = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _usoAtual = await Api.GetUsoAtualAsync();
            if (_usoAtual is null)
            {
                _veiculosDisponiveis = (await Api.GetVehiclesAsync())
                    .Where(v => v.Status == VehicleStatus.Disponivel)
                    .ToList();
                _empresas = (await Api.GetEmpresasAsync()).ToList();
                _motivos = (await Api.GetMotivosUsoAsync()).ToList();
            }
            else
            {
                _detalhe = await Api.GetUsageRecordDetailAsync(_usoAtual.Id);
            }
        }
        catch (HttpRequestException ex)
        {
            _loadError = $"Não foi possível carregar: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleIniciarAsync()
    {
        _submitting = true;
        _actionError = null;
        try
        {
            if (!Guid.TryParse(_startForm.VeiculoId, out var veiculoId))
            {
                _actionError = "Selecione um veículo.";
                return;
            }

            Guid? empresaId = Guid.TryParse(_startForm.EmpresaId, out var parsedEmpresaId) ? parsedEmpresaId : null;

            await Api.IniciarUsoAsync(new StartUsageRequest(
                veiculoId, _startForm.Finalidade, _startForm.Origem, _startForm.Destino, _startForm.OdometroInicial, empresaId));
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _actionError = $"Não foi possível iniciar o uso: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task HandlePainelPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        _lendoPainel = true;
        _actionError = null;
        _actionStatus = null;
        try
        {
            var geo = await JS.InvokeAsync<GeoPosition?>("getGeolocation");

            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var leitura = await Api.LerPainelAsync(memoryStream, file.Name, file.ContentType, geo?.Lat, geo?.Lng);
            if (leitura?.OdometroLido is { } lido)
                _startForm.OdometroInicial = lido;
            if (!string.IsNullOrWhiteSpace(leitura?.EnderecoSugerido))
                _startForm.Origem = leitura!.EnderecoSugerido;

            var mensagem = leitura is { OdometroLido: null, EnderecoSugerido: null }
                ? "Não consegui ler nada dessa foto — preencha manualmente."
                : "Foto lida — confira os campos preenchidos antes de iniciar.";
            if (geo?.Error is not null)
                mensagem += $" (Localização não capturada: {geo.Error})";
            _actionStatus = mensagem;
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            _actionError = $"Não foi possível ler a foto do painel: {ex.Message}";
        }
        finally
        {
            _lendoPainel = false;
        }
    }

    private async Task HandlePhotoSelectedAsync(InputFileChangeEventArgs e, VehiclePhotoType tipo)
    {
        if (_usoAtual is null)
            return;

        _uploadingPhoto = true;
        _actionError = null;
        _actionStatus = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var foto = await Api.UploadFotoAsync(_usoAtual.Id, memoryStream, file.Name, file.ContentType, tipo, null);
            if (foto?.OdometroLido is { } lido)
            {
                _actionStatus = $"Foto enviada. Leitura sugerida do odômetro: {lido} km — confira antes de usar.";
                if (tipo == VehiclePhotoType.OdometroFinal)
                    _finishForm.OdometroFinal = lido;
            }
            else
            {
                _actionStatus = "Foto enviada.";
            }
            _detalhe = await Api.GetUsageRecordDetailAsync(_usoAtual.Id);
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            _actionError = $"Não foi possível enviar a foto: {ex.Message}";
        }
        finally
        {
            _uploadingPhoto = false;
        }
    }

    private async Task HandleVoiceNoteSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_usoAtual is null)
            return;

        _uploadingVoice = true;
        _actionError = null;
        _actionStatus = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            await Api.UploadNotaDeVozAsync(_usoAtual.Id, memoryStream, file.Name, file.ContentType);
            _actionStatus = "Nota de voz enviada — transcrição pode levar alguns segundos.";
            _detalhe = await Api.GetUsageRecordDetailAsync(_usoAtual.Id);
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            _actionError = $"Não foi possível enviar a nota de voz: {ex.Message}";
        }
        finally
        {
            _uploadingVoice = false;
        }
    }

    private async Task HandleReceiptPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_usoAtual is null)
            return;

        _lendoComprovante = true;
        _actionError = null;
        _actionStatus = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var leitura = await Api.LerComprovanteAsync(_usoAtual.Id, memoryStream, file.Name, file.ContentType);
            if (leitura?.Litros is { } litros)
                _fuelForm.Litros = litros;
            if (leitura?.ValorTotal is { } valorTotal)
                _fuelForm.ValorTotal = valorTotal;
            if (leitura?.ValorPorLitro is { } valorPorLitro)
                _fuelForm.ValorPorLitro = valorPorLitro;

            _actionStatus = leitura is { Litros: null, ValorTotal: null, ValorPorLitro: null }
                ? "Não consegui ler nada desse comprovante — preencha manualmente."
                : "Comprovante lido — confira os valores antes de registrar.";
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            _actionError = $"Não foi possível ler o comprovante: {ex.Message}";
        }
        finally
        {
            _lendoComprovante = false;
        }
    }

    private async Task HandleFuelAsync()
    {
        if (_usoAtual is null)
            return;

        _submitting = true;
        _actionError = null;
        try
        {
            await Api.AddAbastecimentoAsync(_usoAtual.Id, new AddFuelEntryRequest(
                _fuelForm.Litros, _fuelForm.ValorTotal, _fuelForm.Odometro, _fuelForm.ValorPorLitro));
            _actionStatus = "Abastecimento registrado.";
            _detalhe = await Api.GetUsageRecordDetailAsync(_usoAtual.Id);
        }
        catch (HttpRequestException ex)
        {
            _actionError = $"Não foi possível registrar o abastecimento: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task HandleFinalizarAsync()
    {
        if (_usoAtual is null)
            return;

        _submitting = true;
        _actionError = null;
        try
        {
            await Api.FinalizarUsoAsync(_usoAtual.Id, _finishForm.OdometroFinal);
            _usoAtual = null;
            _detalhe = null;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _actionError = $"Não foi possível finalizar o uso: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private class StartForm
    {
        public string VeiculoId { get; set; } = string.Empty;
        public string EmpresaId { get; set; } = string.Empty;
        public string Finalidade { get; set; } = string.Empty;
        public string? Origem { get; set; }
        public string? Destino { get; set; }
        public int OdometroInicial { get; set; }
    }

    private class FuelForm
    {
        public decimal Litros { get; set; }
        public decimal ValorTotal { get; set; }
        public decimal? ValorPorLitro { get; set; }
        public int Odometro { get; set; }
    }

    private class FinishForm
    {
        public int OdometroFinal { get; set; }
    }

    private class GeoPosition
    {
        public double? Lat { get; set; }
        public double? Lng { get; set; }
        public string? Error { get; set; }
    }
}
