@page "/usos/{Id:guid}"
@using ControleVeiculos.Domain.Enums
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BaseOperacional Base

<PageTitle>Uso registrado</PageTitle>

<a class="btn btn-soft mb-3 d-inline-flex align-items-center gap-1" href="usos"><Icon Name="chevron-left" Size="18" /> Voltar</a>

@if (_error is not null)
{
    <Mensagens Erro="@_error" />
}
else if (_uso is null)
{
    <div class="loading-block"><span class="spinner"></span> Carregando...</div>
}
else
{
    var status = Rotulos.Uso(_uso.Status);

    <div class="status-hero">
        <span class="live-dot">@status.Texto</span>
        <div class="hero-plate">@_uso.VeiculoPlaca</div>
        <div class="hero-sub">@_uso.Finalidade@(_uso.EmpresaNome is null ? "" : $" · {_uso.EmpresaNome}")</div>
        <div class="hero-grid">
            <div>
                <div class="hero-label">Motorista</div>
                <div class="hero-value">@_uso.MotoristaNome</div>
            </div>
            <div>
                <div class="hero-label">Km rodados</div>
                <div class="hero-value">@(_uso.OdometroFinal is { } f ? $"{f - _uso.OdometroInicial:N0} km" : "—")</div>
            </div>
            <div>
                <div class="hero-label">Saída</div>
                <div class="hero-value">@Rotulos.DataHora(_uso.IniciadoEm)</div>
                <div class="hero-sub">@Rotulos.Km(_uso.OdometroInicial)</div>
            </div>
            <div>
                <div class="hero-label">Chegada</div>
                <div class="hero-value">@(_uso.FinalizadoEm is { } fim ? Rotulos.DataHora(fim) : "Em andamento")</div>
                @if (_uso.OdometroFinal is { } kmFinal)
                {
                    <div class="hero-sub">@Rotulos.Km(kmFinal)</div>
                }
            </div>
            <div class="hero-full">
                <div class="hero-label">Saiu de</div>
                <div class="hero-value">@(_uso.Origem ?? "Não informado")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_uso.Destino) || _uso.Status == UsageRecordStatus.Finalizado)
            {
                <div class="hero-full">
                    <div class="hero-label">Chegou em (onde o carro ficou)</div>
                    <div class="hero-value">@(string.IsNullOrWhiteSpace(_uso.Destino) ? "Não informado" : _uso.Destino)</div>
                </div>
            }
        </div>
    </div>

    @if (_ehAdmin && _edicao is null)
    {
        <button type="button" class="btn btn-soft btn-app mt-3" @onclick="AbrirEdicaoAsync"><Icon Name="pencil" Size="18" /><span>Editar saída</span></button>
    }
    <Mensagens Sucesso="@_ok" />

    @if (_edicao is { } e)
    {
        <div class="section-title">Editar saída</div>
        <div class="card-app edicao-card">
            <div class="field">
                <label>Motorista</label>
                <select class="form-select" @bind="e.MotoristaId">
                    @foreach (var d in _motoristas)
                    {
                        <option value="@d.Id">@d.Nome</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Empresa / categoria</label>
                <select class="form-select" @bind="e.EmpresaId">
                    <option value="">(nenhuma)</option>
                    @foreach (var emp in _empresas)
                    {
                        <option value="@emp.Id">@emp.Nome</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Motivo</label>
                <input class="form-control" list="motivos-edicao" @bind="e.Finalidade" @bind:event="oninput" />
                <datalist id="motivos-edicao">
                    @foreach (var m in _motivos)
                    {
                        <option value="@m"></option>
                    }
                </datalist>
                <div class="field-hint">Escolha um da lista para manter o padrão.</div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Saída</label>
                    <input class="form-control" type="datetime-local" @bind="e.Saida" />
                </div>
                <div class="field">
                    <label>Km saída</label>
                    <input class="form-control" type="number" inputmode="numeric" @bind="e.KmSaida" />
                </div>
            </div>
            @if (_uso.Status == UsageRecordStatus.Finalizado)
            {
                <div class="field-row">
                    <div class="field">
                        <label>Chegada</label>
                        <input class="form-control" type="datetime-local" @bind="e.Chegada" />
                    </div>
                    <div class="field">
                        <label>Km chegada</label>
                        <input class="form-control" type="number" inputmode="numeric" @bind="e.KmChegada" />
                    </div>
                </div>
                @if (e.KmChegada is { } kc && kc >= e.KmSaida)
                {
                    <div class="field-hint mb-3">= @((kc - e.KmSaida).ToString("N0")) km rodados</div>
                }
            }
            <datalist id="locais-edicao">
                <option value="@TextoBase"></option>
                <option value="OFICINA"></option>
            </datalist>
            <div class="field">
                <label>Saiu de</label>
                <input class="form-control" list="locais-edicao" @bind="e.Origem" @bind:event="oninput" placeholder="Base, OFICINA, endereço..." />
            </div>
            @if (_uso.Status == UsageRecordStatus.Finalizado)
            {
                <div class="field">
                    <label>Chegou em (onde o carro ficou)</label>
                    <input class="form-control" list="locais-edicao" @bind="e.Destino" @bind:event="oninput" placeholder="Base, OFICINA, endereço..." />
                </div>
            }
            <div class="field">
                <label>Observação</label>
                <textarea class="form-control" rows="3" @bind="e.Observacao"></textarea>
            </div>
            <Mensagens Erro="@_erroEdicao" />
            <div class="zerar-acoes">
                <button type="button" class="btn btn-soft btn-app" disabled="@_salvando" @onclick="() => _edicao = null">Cancelar</button>
                <button type="button" class="btn btn-primary btn-app" disabled="@_salvando" @onclick="SalvarEdicaoAsync">
                    @if (_salvando)
                    {
                        <span class="spinner"></span><span>Salvando...</span>
                    }
                    else
                    {
                        <Icon Name="check" Size="20" /><span>Salvar</span>
                    }
                </button>
            </div>
        </div>
    }

    @if (_edicao is null && (_uso.Importado || !string.IsNullOrWhiteSpace(_uso.Observacao)))
    {
        <div class="card-app mt-3">
            @if (_uso.Importado)
            {
                <span class="chip chip-primary mb-2 d-inline-block">Importada da planilha (registro em papel)</span>
            }
            @if (!string.IsNullOrWhiteSpace(_uso.Observacao))
            {
                <div style="white-space:pre-line">@_uso.Observacao</div>
            }
        </div>
    }

    @if (_uso.LatitudeInicial is { } latSaida && _uso.LongitudeInicial is { } lngSaida)
    {
        <div class="section-title">Local de saída</div>
        <MapaMini Latitude="latSaida" Longitude="lngSaida" />
    }

    @if (_uso.LatitudeFinal is { } latChegada && _uso.LongitudeFinal is { } lngChegada)
    {
        <div class="section-title">Onde o carro ficou</div>
        <MapaMini Latitude="latChegada" Longitude="lngChegada" />
    }

    <div class="section-title">Abastecimentos (@_uso.Abastecimentos.Count)</div>
    @if (_uso.Abastecimentos.Count == 0)
    {
        <div class="card-app muted">Nenhum abastecimento registrado.</div>
    }
    else
    {
        <div class="list-card">
            @foreach (var a in _uso.Abastecimentos)
            {
                <div class="list-item">
                    <span class="avatar tone-accent"><Icon Name="fuel" Size="20" /></span>
                    <span class="list-item-main">
                        <span class="list-item-title d-block">@a.Litros.ToString("N3") L · R$ @a.ValorTotal.ToString("N2")@(a.TanqueCheio ? "" : " · tanque não completado")@(a.PagoPeloMotorista ? " · pago pelo motorista" : "")</span>
                        <span class="list-item-sub d-block">@(a.ValorPorLitro is { } vpl ? $"R$ {vpl:N3}/L · " : "")@Rotulos.Km(a.Odometro) · @Rotulos.Hora(a.CreatedAt)</span>
                    </span>
                    @if (a.Latitude is { } lat && a.Longitude is { } lng)
                    {
                        <a class="btn-icon" title="Ver o posto no mapa" target="_blank" rel="noopener"
                           href="@($"https://www.google.com/maps/search/?api=1&query={lat.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lng.ToString(System.Globalization.CultureInfo.InvariantCulture)}")">
                            <Icon Name="pin" Size="18" />
                        </a>
                    }
                    @if (_ehAdmin && _abastEdicao?.Id != a.Id)
                    {
                        <button class="btn-icon" title="Editar abastecimento" @onclick="() => AbrirAbastecimento(a)"><Icon Name="pencil" Size="18" /></button>
                    }
                </div>
                @if (_abastEdicao is { } ab && ab.Id == a.Id)
                {
                    <div class="abast-edicao">
                        <div class="field-row">
                            <div class="field mb-2">
                                <label>Litros</label>
                                <input class="form-control" type="number" inputmode="decimal" step="0.001" @bind="ab.Litros" />
                            </div>
                            <div class="field mb-2">
                                <label>Valor (R$)</label>
                                <input class="form-control" type="number" inputmode="decimal" step="0.01" @bind="ab.Valor" />
                            </div>
                        </div>
                        <div class="field mb-2">
                            <label>Km no abastecimento</label>
                            <input class="form-control" type="number" inputmode="numeric" @bind="ab.Km" />
                        </div>
                        <label class="zerar-manter mb-2"><input type="checkbox" @bind="ab.TanqueCheio" /><span>Encheu o tanque</span></label>
                        <label class="zerar-manter mb-2"><input type="checkbox" @bind="ab.DoBolso" /><span>Pago pelo motorista (do bolso)</span></label>
                        <Mensagens Erro="@_erroAbast" />
                        <div class="zerar-acoes">
                            <button type="button" class="btn btn-soft" disabled="@_salvando" @onclick="() => _abastEdicao = null">Cancelar</button>
                            <button type="button" class="btn btn-primary" disabled="@_salvando" @onclick="SalvarAbastecimentoAsync">Salvar</button>
                        </div>
                    </div>
                }
            }
        </div>
    }

    <div class="section-title">Notas de voz (@_uso.NotasDeVoz.Count)</div>
    @if (_uso.NotasDeVoz.Count == 0)
    {
        <div class="card-app muted">Nenhuma nota de voz.</div>
    }
    else
    {
        <div class="list-card">
            @foreach (var nota in _uso.NotasDeVoz)
            {
                <div class="list-item">
                    <span class="avatar tone-violet"><Icon Name="mic" Size="20" /></span>
                    <span class="list-item-main">
                        <span class="d-block" style="white-space:normal">@(string.IsNullOrWhiteSpace(nota.TranscricaoTexto) ? "(sem transcrição)" : $"“{nota.TranscricaoTexto}”")</span>
                        <span class="list-item-sub d-block">@StatusNota(nota.Status) · @Rotulos.DataHora(nota.CreatedAt)</span>
                    </span>
                </div>
            }
        </div>
    }

    <div class="section-title">Fotos (@_uso.Fotos.Count)</div>
    @if (_uso.Fotos.Count == 0)
    {
        <div class="card-app muted">Nenhuma foto anexada.</div>
    }
    else
    {
        <div class="list-card">
            @foreach (var foto in _uso.Fotos)
            {
                <div class="list-item">
                    <span class="avatar"><Icon Name="image" Size="20" /></span>
                    <span class="list-item-main">
                        <span class="list-item-title d-block">@Rotulos.Foto(foto.Tipo)</span>
                        <span class="list-item-sub d-block">@Rotulos.DataHora(foto.CreatedAt)@(foto.OdometroLido is { } lido ? $" · km lido: {lido:N0}" : "")</span>
                    </span>
                </div>
            }
        </div>
    }
}

@if (_uso is not null && AuthState.IsInRole("Admin"))
{
    <div class="zona-perigo">
        <Mensagens Erro="@_erroExcluir" />
        <button type="button" class="btn btn-soft btn-app" disabled="@_excluindo" @onclick="ExcluirAsync">
            @if (_excluindo)
            {
                <span class="spinner"></span><span>Apagando...</span>
            }
            else
            {
                <Icon Name="trash" Size="18" /><span>Apagar esta saída</span>
            }
        </button>
        <div class="field-hint text-center mt-2">Ex.: saída feita num treinamento. Some com fotos, áudios e abastecimentos.</div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ControleVeiculos.Shared.UsageRecords.UsageRecordDetailDto? _uso;
    private string? _error;
    private bool _excluindo;
    private string? _erroExcluir;

    private bool _ehAdmin => AuthState.IsInRole("Admin");
    private EdicaoModel? _edicao;
    private AbastecimentoModel? _abastEdicao;
    private List<ControleVeiculos.Shared.Drivers.DriverDto> _motoristas = [];
    private List<ControleVeiculos.Shared.Empresas.EmpresaDto> _empresas = [];
    private List<string> _motivos = [];
    private bool _salvando;
    private string? _erroEdicao;
    private string? _erroAbast;
    private string? _ok;

    private static readonly TimeSpan Brasilia = TimeSpan.FromHours(-3);
    private string TextoBase => $"{Base.Nome} - {Base.Endereco}";

    private class EdicaoModel
    {
        public Guid MotoristaId { get; set; }
        public Guid? EmpresaId { get; set; }
        public string Finalidade { get; set; } = "";
        public DateTime Saida { get; set; }
        public DateTime? Chegada { get; set; }
        public int KmSaida { get; set; }
        public int? KmChegada { get; set; }
        public string? Observacao { get; set; }
        public string? Origem { get; set; }
        public string? Destino { get; set; }
    }

    private class AbastecimentoModel
    {
        public Guid Id { get; set; }
        public decimal Litros { get; set; }
        public decimal Valor { get; set; }
        public int Km { get; set; }
        public bool TanqueCheio { get; set; }
        public bool DoBolso { get; set; }
    }

    private async Task AbrirEdicaoAsync()
    {
        _ok = _erroEdicao = null;
        try
        {
            var motoristas = Api.GetDriversAsync();
            var empresas = Api.GetEmpresasAsync();
            var motivos = Api.GetMotivosEmUsoAsync();
            await Task.WhenAll(motoristas, empresas, motivos);
            _motoristas = motoristas.Result.OrderBy(d => d.Nome).ToList();
            _empresas = empresas.Result.OrderBy(x => x.Nome).ToList();
            _motivos = motivos.Result.Select(m => m.Nome).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _ok = null;
            _erroEdicao = "Não foi possível carregar motoristas/empresas.";
        }

        _edicao = new EdicaoModel
        {
            MotoristaId = _uso!.MotoristaId,
            EmpresaId = _uso.EmpresaId,
            Finalidade = _uso.Finalidade,
            Saida = _uso.IniciadoEm.ToOffset(Brasilia).DateTime,
            Chegada = _uso.FinalizadoEm?.ToOffset(Brasilia).DateTime,
            KmSaida = _uso.OdometroInicial,
            KmChegada = _uso.OdometroFinal,
            Observacao = _uso.Observacao,
            Origem = _uso.Origem,
            Destino = _uso.Destino,
        };
    }

    private async Task SalvarEdicaoAsync()
    {
        var e = _edicao!;
        _salvando = true;
        _erroEdicao = null;
        try
        {
            var atualizado = await Api.EditarUsoAsync(Id, new ControleVeiculos.Shared.UsageRecords.UpdateUsageRequest(
                e.MotoristaId, e.EmpresaId, e.Finalidade, e.KmSaida, e.KmChegada,
                new DateTimeOffset(e.Saida, Brasilia),
                e.Chegada is { } c ? new DateTimeOffset(c, Brasilia) : null,
                e.Observacao, e.Origem, e.Destino));
            if (atualizado is not null)
                _uso = atualizado;
            _edicao = null;
            _ok = "✅ Saída atualizada.";
        }
        catch (HttpRequestException ex)
        {
            _erroEdicao = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private void AbrirAbastecimento(ControleVeiculos.Shared.UsageRecords.FuelEntryDto a)
    {
        _erroAbast = _ok = null;
        _abastEdicao = new AbastecimentoModel
        {
            Id = a.Id, Litros = a.Litros, Valor = a.ValorTotal, Km = a.Odometro, TanqueCheio = a.TanqueCheio, DoBolso = a.PagoPeloMotorista,
        };
    }

    private async Task SalvarAbastecimentoAsync()
    {
        var a = _abastEdicao!;
        _salvando = true;
        _erroAbast = null;
        try
        {
            await Api.EditarAbastecimentoAsync(Id, a.Id, new ControleVeiculos.Shared.UsageRecords.UpdateFuelEntryRequest(a.Litros, a.Valor, a.Km, a.TanqueCheio, a.DoBolso));
            _uso = await Api.GetUsageRecordDetailAsync(Id) ?? _uso;
            _abastEdicao = null;
            _ok = "✅ Abastecimento atualizado.";
        }
        catch (HttpRequestException ex)
        {
            _erroAbast = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task ExcluirAsync()
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm",
            $"Apagar a saída de {_uso!.MotoristaNome} em {Rotulos.DataHora(_uso.IniciadoEm)} ({_uso.Finalidade})?\n\nSome com fotos, áudios e abastecimentos. Não dá pra desfazer.");
        if (!confirmar)
            return;

        _excluindo = true;
        _erroExcluir = null;
        try
        {
            await Api.ExcluirUsoAsync(Id);
            Nav.NavigateTo("/usos");
        }
        catch (HttpRequestException ex)
        {
            _erroExcluir = ex.Message;
            _excluindo = false;
        }
    }

    private static string StatusNota(VoiceNoteStatus status) => status switch
    {
        VoiceNoteStatus.Transcrito => "Transcrita",
        VoiceNoteStatus.Pendente => "Transcrevendo...",
        VoiceNoteStatus.Falhou => "Falha na transcrição",
        _ => status.ToString(),
    };

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            _uso = await Api.GetUsageRecordDetailAsync(Id);
            if (_uso is null)
                _error = "Uso não encontrado.";
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar o uso.";
        }
    }
}
