@page "/login"
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Entrar · Controle de Veículos</PageTitle>

<div class="auth-hero">
    <div class="app-brand-logo"><Icon Name="car" Size="34" /></div>
    <h1>Controle de Veículos</h1>
    <p>Registro de uso da frota</p>
</div>

<div class="auth-card">
    @if (!_mostrarCadastro)
    {
        <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
            <div class="field">
                <label>Usuário ou e-mail</label>
                <div class="input-with-icon">
                    <span class="input-icon"><Icon Name="user" Size="18" /></span>
                    <InputText class="form-control" @bind-Value="_model.Login" autocapitalize="characters" autocomplete="username" placeholder="Ex.: DANI" />
                </div>
            </div>
            <div class="field">
                <label>Senha</label>
                <div class="input-with-icon">
                    <span class="input-icon"><Icon Name="lock" Size="18" /></span>
                    <InputText class="form-control" type="password" @bind-Value="_model.Password" autocomplete="current-password" />
                </div>
            </div>

            @if (_error is not null)
            {
                <div class="notice notice-error">@_error</div>
            }

            <button type="submit" class="btn btn-primary btn-app" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner"></span><span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </button>
        </EditForm>

        <button type="button" class="auth-switch" @onclick="() => _mostrarCadastro = true">Não tem conta? Criar conta</button>
    }
    else
    {
        <EditForm Model="_registerModel" OnValidSubmit="HandleRegisterAsync">
            <div class="field">
                <label>Nome completo</label>
                <InputText class="form-control" @bind-Value="_registerModel.NomeCompleto" autocomplete="name" />
            </div>
            <div class="field">
                <label>E-mail</label>
                <InputText class="form-control" type="email" @bind-Value="_registerModel.Email" autocomplete="email" />
            </div>
            <div class="field">
                <label>Senha</label>
                <InputText class="form-control" type="password" @bind-Value="_registerModel.Password" autocomplete="new-password" />
                <div class="field-hint">Mínimo de 8 caracteres, com letra e número.</div>
            </div>
            <div class="field">
                <label>Papel</label>
                <InputSelect class="form-select" @bind-Value="_registerModel.Role">
                    <option value="Motorista">Motorista</option>
                    <option value="Gestor">Gestor</option>
                    <option value="Admin">Admin</option>
                </InputSelect>
            </div>

            @if (_registerError is not null)
            {
                <div class="notice notice-error">@_registerError</div>
            }

            <button type="submit" class="btn btn-primary btn-app" disabled="@_registerLoading">
                @if (_registerLoading)
                {
                    <span class="spinner"></span><span>Criando...</span>
                }
                else
                {
                    <span>Criar conta</span>
                }
            </button>
        </EditForm>

        <button type="button" class="auth-switch" @onclick="() => _mostrarCadastro = false">Já tenho conta · Entrar</button>
    }
</div>

@code {
    private readonly LoginModel _model = new();
    private readonly RegisterModel _registerModel = new();
    private string? _error;
    private string? _registerError;
    private bool _loading;
    private bool _registerLoading;
    private bool _mostrarCadastro;

    private async Task HandleLoginAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.LoginAsync(_model.Login.Trim(), _model.Password);
            if (result is null)
            {
                _error = "Não foi possível autenticar.";
                return;
            }

            AuthState.SignIn(result.Token, _model.Login.Trim());
            Nav.NavigateTo("/");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            _error = "Usuário ou senha inválidos.";
        }
        catch (HttpRequestException)
        {
            _error = "O servidor está iniciando (isso acontece após um tempo sem uso) — aguarde alguns segundos e tente entrar de novo.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleRegisterAsync()
    {
        _registerLoading = true;
        _registerError = null;
        try
        {
            var result = await Api.RegisterAsync(_registerModel.NomeCompleto, _registerModel.Email, _registerModel.Password, _registerModel.Role);
            if (result is null)
            {
                _registerError = "Não foi possível cadastrar.";
                return;
            }

            AuthState.SignIn(result.Token, _registerModel.Email);
            Nav.NavigateTo("/");
        }
        catch (HttpRequestException ex)
        {
            _registerError = $"Não foi possível cadastrar: {ex.Message}";
        }
        finally
        {
            _registerLoading = false;
        }
    }

    private class LoginModel
    {
        public string Login { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private class RegisterModel
    {
        public string NomeCompleto { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "Motorista";
    }
}
