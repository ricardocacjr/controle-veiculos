@page "/login"
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Entrar</PageTitle>

<h1>Entrar</h1>

<EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
    <div class="mb-3">
        <label class="form-label">Usuário ou e-mail</label>
        <InputText class="form-control" @bind-Value="_model.Login" />
    </div>
    <div class="mb-3">
        <label class="form-label">Senha</label>
        <InputText class="form-control" type="password" @bind-Value="_model.Password" />
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <button type="submit" class="btn btn-primary" disabled="@_loading">Entrar</button>
</EditForm>

<hr />

<h2>Criar conta</h2>

<EditForm Model="_registerModel" OnValidSubmit="HandleRegisterAsync">
    <div class="mb-3">
        <label class="form-label">Nome completo</label>
        <InputText class="form-control" @bind-Value="_registerModel.NomeCompleto" />
    </div>
    <div class="mb-3">
        <label class="form-label">E-mail</label>
        <InputText class="form-control" @bind-Value="_registerModel.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Senha</label>
        <InputText class="form-control" type="password" @bind-Value="_registerModel.Password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Papel</label>
        <InputSelect class="form-select" @bind-Value="_registerModel.Role">
            <option value="Admin">Admin</option>
            <option value="Gestor">Gestor</option>
            <option value="Motorista">Motorista</option>
        </InputSelect>
    </div>

    @if (_registerError is not null)
    {
        <div class="alert alert-danger">@_registerError</div>
    }

    <button type="submit" class="btn btn-secondary" disabled="@_registerLoading">Cadastrar</button>
</EditForm>

@code {
    private readonly LoginModel _model = new();
    private readonly RegisterModel _registerModel = new();
    private string? _error;
    private string? _registerError;
    private bool _loading;
    private bool _registerLoading;

    private async Task HandleLoginAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.LoginAsync(_model.Login, _model.Password);
            if (result is null)
            {
                _error = "Não foi possível autenticar.";
                return;
            }

            AuthState.SignIn(result.Token, _model.Login);
            Nav.NavigateTo("/usos");
        }
        catch (HttpRequestException)
        {
            _error = "E-mail ou senha inválidos.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleRegisterAsync()
    {
        _registerLoading = true;
        _registerError = null;
        try
        {
            var result = await Api.RegisterAsync(_registerModel.NomeCompleto, _registerModel.Email, _registerModel.Password, _registerModel.Role);
            if (result is null)
            {
                _registerError = "Não foi possível cadastrar.";
                return;
            }

            AuthState.SignIn(result.Token, _registerModel.Email);
            Nav.NavigateTo("/usos");
        }
        catch (HttpRequestException ex)
        {
            _registerError = $"Não foi possível cadastrar: {ex.Message}";
        }
        finally
        {
            _registerLoading = false;
        }
    }

    private class LoginModel
    {
        public string Login { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private class RegisterModel
    {
        public string NomeCompleto { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "Motorista";
    }
}
