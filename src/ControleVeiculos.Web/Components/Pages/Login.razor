@page "/login"
@using ControleVeiculos.Shared.Auth
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Entrar · Controle de Veículos</PageTitle>

@if (_perfilEscolhido is { } perfil)
{
    <div class="pin-screen">
        <Avatar UserId="perfil.UserId" Nome="@perfil.Nome" TemFoto="perfil.TemFoto" Versao="@perfil.FotoVersao" />
        <h1 class="pin-title">Olá, @PrimeiroNome(perfil.Nome)!</h1>
        <p class="pin-sub">@(perfil.PrecisaDefinirPin ? "Digite o PIN que o administrador te passou" : "Digite seu PIN de 6 números")</p>

        <PinPad Erro="@_erro" Ocupado="@_entrando" OnCompleto="EntrarComPinAsync" />

        <div class="pin-links">
            <button type="button" @onclick="Voltar">← Trocar pessoa</button>
            <button type="button" @onclick="() => _erro = EsqueciPin">Esqueci o PIN</button>
        </div>
    </div>
}
else if (_modoAdmin)
{
    <div class="auth-hero">
        <div class="app-brand-logo"><Icon Name="lock" Size="30" /></div>
        <h1>Administração</h1>
        <p>Acesso com e-mail e senha</p>
    </div>
    <div class="auth-card">
        <EditForm Model="_admin" OnValidSubmit="EntrarAdminAsync">
            <div class="field">
                <label>E-mail ou usuário</label>
                <InputText class="form-control" @bind-Value="_admin.Login" autocomplete="username" />
            </div>
            <div class="field">
                <label>Senha</label>
                <InputText class="form-control" type="password" @bind-Value="_admin.Senha" autocomplete="current-password" />
            </div>
            <Mensagens Erro="@_erro" />
            <button type="submit" class="btn btn-primary btn-app" disabled="@_entrando">
                @if (_entrando)
                {
                    <span class="spinner"></span><span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </button>
        </EditForm>
        <button type="button" class="auth-switch" @onclick="Voltar">← Voltar</button>
    </div>
}
else
{
    <h1 class="profile-title">Quem vai usar o carro?</h1>

    @if (_perfis is null)
    {
        <div class="loading-block auth-loading"><span class="spinner"></span> @(_demorando ? "Ligando o servidor, aguarde..." : "Carregando...")</div>
    }
    else if (_perfis.Count == 0)
    {
        <p class="text-center auth-loading">Nenhum motorista cadastrado.</p>
    }
    else
    {
        <div class="profile-grid">
            @foreach (var p in _perfis)
            {
                <button type="button" class="profile-tile" @onclick="() => Escolher(p)">
                    <Avatar UserId="p.UserId" Nome="@p.Nome" TemFoto="p.TemFoto" Versao="@p.FotoVersao" />
                    <span class="profile-name">@PrimeiroNome(p.Nome)</span>
                </button>
            }
        </div>
    }

    @if (_erroLista is not null)
    {
        <div class="notice notice-error mt-3" style="max-width:420px;margin:0 auto">@_erroLista</div>
    }

    <button type="button" class="auth-link" @onclick="() => { _modoAdmin = true; _erro = null; }">Acesso do administrador</button>
}

@code {
    private const string EsqueciPin = "Peça ao administrador (Ricardo) para criar um PIN novo pra você.";

    private List<PerfilDto>? _perfis;
    private PerfilDto? _perfilEscolhido;
    private bool _modoAdmin;
    private bool _entrando;
    private bool _demorando;
    private string? _erro;
    private string? _erroLista;
    private readonly AdminModel _admin = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/");
            return;
        }

        _ = Task.Delay(2500).ContinueWith(_ => { _demorando = true; InvokeAsync(StateHasChanged); });
        try
        {
            _perfis = (await Api.GetPerfisAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            _perfis = [];
            _erroLista = "Não consegui carregar os perfis. Verifique a internet e abra o app de novo.";
        }
    }

    private static string PrimeiroNome(string nome) =>
        nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nome;

    private void Escolher(PerfilDto perfil)
    {
        _perfilEscolhido = perfil;
        _erro = null;
    }

    private void Voltar()
    {
        _perfilEscolhido = null;
        _modoAdmin = false;
        _erro = null;
    }

    private async Task EntrarComPinAsync(string pin)
    {
        if (_perfilEscolhido is null)
            return;

        _erro = null;
        _entrando = true;
        try
        {
            var resposta = await Api.LoginAsync(_perfilEscolhido.Login, pin);
            if (resposta is null)
            {
                _erro = "Não foi possível entrar.";
                return;
            }

            await AuthState.EntrarAsync(resposta.Token, _perfilEscolhido.Login, resposta.PrecisaDefinirPin, pin);
            await JS.InvokeVoidAsync("cvVibrar", 40);
            Nav.NavigateTo(resposta.PrecisaDefinirPin ? "/primeiro-acesso" : "/");
        }
        catch (HttpRequestException ex)
        {
            _erro = MensagemErro(ex, "PIN incorreto. Tente de novo.");
        }
        finally
        {
            _entrando = false;
        }
    }

    private async Task EntrarAdminAsync()
    {
        _erro = null;
        _entrando = true;
        try
        {
            var login = _admin.Login.Trim();
            var resposta = await Api.LoginAsync(login, _admin.Senha);
            if (resposta is null)
            {
                _erro = "Não foi possível entrar.";
                return;
            }

            await AuthState.EntrarAsync(resposta.Token, login, resposta.PrecisaDefinirPin, _admin.Senha);
            Nav.NavigateTo(resposta.PrecisaDefinirPin ? "/primeiro-acesso" : "/");
        }
        catch (HttpRequestException ex)
        {
            _erro = MensagemErro(ex, "Usuário ou senha inválidos.");
        }
        finally
        {
            _entrando = false;
        }
    }

    private static string MensagemErro(HttpRequestException ex, string credencialErrada) => ex.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized => credencialErrada,
        System.Net.HttpStatusCode.Locked => ex.Message,
        _ => "O servidor está iniciando — aguarde alguns segundos e tente de novo.",
    };

    private class AdminModel
    {
        public string Login { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }
}
