@page "/veiculos"
@using ControleVeiculos.Domain.Enums
@using ControleVeiculos.Shared.Vehicles
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Veículos</PageTitle>

<h1 class="page-title">Veículos</h1>
<p class="page-subtitle">Frota disponível para os motoristas.</p>

@if (AuthState.IsAuthenticated)
{
    <div class="section-title">@(_editingId is null ? "Novo veículo" : "Editar veículo")</div>
    <div class="card-app">
        <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
            <div class="form-grid">
                <div class="field">
                    <label>Placa</label>
                    <InputText class="form-control" @bind-Value="_form.Placa" autocapitalize="characters" />
                </div>
                <div class="field">
                    <label>Marca</label>
                    <InputText class="form-control" @bind-Value="_form.Marca" />
                </div>
                <div class="field">
                    <label>Modelo</label>
                    <InputText class="form-control" @bind-Value="_form.Modelo" />
                </div>
                <div class="field">
                    <label>Ano</label>
                    <InputNumber class="form-control" @bind-Value="_form.Ano" inputmode="numeric" />
                </div>
                <div class="field">
                    <label>Cor</label>
                    <InputText class="form-control" @bind-Value="_form.Cor" />
                </div>
                <div class="field">
                    <label>Odômetro (km)</label>
                    <InputNumber class="form-control" @bind-Value="_form.OdometroAtual" inputmode="numeric" />
                </div>
                @if (_editingId is not null)
                {
                    <div class="field">
                        <label>Status</label>
                        <InputSelect class="form-select" @bind-Value="_form.Status">
                            @foreach (var status in Enum.GetValues<VehicleStatus>())
                            {
                                <option value="@status">@Rotulos.Veiculo(status).Texto</option>
                            }
                        </InputSelect>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary btn-app" disabled="@_loading">
                    <Icon Name="@(_editingId is null ? "plus" : "check")" Size="20" /><span>@(_editingId is null ? "Adicionar veículo" : "Salvar alterações")</span>
                </button>
                @if (_editingId is not null)
                {
                    <button type="button" class="btn btn-soft btn-app" style="max-width:140px" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>

    <div class="mt-3"><Mensagens Erro="@_error" /></div>

    <div class="section-title">Cadastrados</div>
    @if (_vehicles is null)
    {
        <div class="loading-block"><span class="spinner"></span> Carregando...</div>
    }
    else if (_vehicles.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><Icon Name="car" Size="26" /></div>
            <div>Nenhum veículo cadastrado ainda.</div>
        </div>
    }
    else
    {
        <div class="list-card">
            @foreach (var vehicle in _vehicles)
            {
                var status = Rotulos.Veiculo(vehicle.Status);
                <div class="list-item">
                    <span class="avatar"><Icon Name="car" Size="20" /></span>
                    <span class="list-item-main">
                        <span class="list-item-title d-block">@vehicle.Placa · @vehicle.Marca @vehicle.Modelo</span>
                        <span class="list-item-sub d-block">@vehicle.Ano@(string.IsNullOrWhiteSpace(vehicle.Cor) ? "" : $" · {vehicle.Cor}") · @Rotulos.Km(vehicle.OdometroAtual)</span>
                    </span>
                    <span class="chip @status.Chip">@status.Texto</span>
                    <span class="list-item-actions">
                        <button class="btn-icon" title="Editar" @onclick="() => StartEdit(vehicle)"><Icon Name="pencil" Size="18" /></button>
                        <button class="btn-icon danger" title="Remover" @onclick="() => HandleDeleteAsync(vehicle)"><Icon Name="trash" Size="18" /></button>
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    private List<VehicleDto>? _vehicles;
    private string? _error;
    private bool _loading;
    private Guid? _editingId;
    private readonly VehicleFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadVehiclesAsync();
    }

    private async Task LoadVehiclesAsync()
    {
        try
        {
            _vehicles = (await Api.GetVehiclesAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar os veículos.";
            _vehicles = [];
        }
    }

    private void StartEdit(VehicleDto vehicle)
    {
        _editingId = vehicle.Id;
        _form.Placa = vehicle.Placa;
        _form.Marca = vehicle.Marca;
        _form.Modelo = vehicle.Modelo;
        _form.Ano = vehicle.Ano;
        _form.Cor = vehicle.Cor;
        _form.OdometroAtual = vehicle.OdometroAtual;
        _form.Status = vehicle.Status;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        ResetForm();
    }

    private async Task HandleSubmitAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_editingId is { } id)
            {
                var updateRequest = new UpdateVehicleRequest(
                    _form.Placa, _form.Marca, _form.Modelo, _form.Ano, _form.Cor, _form.OdometroAtual, _form.Status);
                await Api.UpdateVehicleAsync(id, updateRequest);
                _editingId = null;
            }
            else
            {
                var createRequest = new CreateVehicleRequest(
                    _form.Placa, _form.Marca, _form.Modelo, _form.Ano, _form.Cor, _form.OdometroAtual);
                await Api.CreateVehicleAsync(createRequest);
            }

            ResetForm();
            await LoadVehiclesAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = $"Não foi possível salvar o veículo: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleDeleteAsync(VehicleDto vehicle)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Remover o veículo {vehicle.Placa} ({vehicle.Marca} {vehicle.Modelo})?");
        if (!confirmado)
            return;

        try
        {
            await Api.DeleteVehicleAsync(vehicle.Id);
            await LoadVehiclesAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível remover o veículo.";
        }
    }

    private void ResetForm()
    {
        _form.Placa = string.Empty;
        _form.Marca = string.Empty;
        _form.Modelo = string.Empty;
        _form.Ano = DateTime.Now.Year;
        _form.Cor = null;
        _form.OdometroAtual = 0;
        _form.Status = VehicleStatus.Disponivel;
    }

    private class VehicleFormModel
    {
        public string Placa { get; set; } = string.Empty;
        public string Marca { get; set; } = string.Empty;
        public string Modelo { get; set; } = string.Empty;
        public int Ano { get; set; } = DateTime.Now.Year;
        public string? Cor { get; set; }
        public int OdometroAtual { get; set; }
        public VehicleStatus Status { get; set; } = VehicleStatus.Disponivel;
    }
}
