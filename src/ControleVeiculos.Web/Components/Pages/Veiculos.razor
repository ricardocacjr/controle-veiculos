@page "/veiculos"
@using ControleVeiculos.Domain.Enums
@using ControleVeiculos.Shared.Vehicles
@inject ControleVeiculosApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Veículos</PageTitle>

<h1>Veículos</h1>

@if (!AuthState.IsAuthenticated)
{
    <p>Você precisa <a href="/login">entrar</a> para ver os veículos.</p>
}
else
{
    <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">
            <div style="width:110px">
                <label class="form-label small mb-0">Placa</label>
                <InputText class="form-control" @bind-Value="_form.Placa" />
            </div>
            <div style="width:130px">
                <label class="form-label small mb-0">Marca</label>
                <InputText class="form-control" @bind-Value="_form.Marca" />
            </div>
            <div style="width:130px">
                <label class="form-label small mb-0">Modelo</label>
                <InputText class="form-control" @bind-Value="_form.Modelo" />
            </div>
            <div style="width:90px">
                <label class="form-label small mb-0">Ano</label>
                <InputNumber class="form-control" @bind-Value="_form.Ano" />
            </div>
            <div style="width:100px">
                <label class="form-label small mb-0">Cor</label>
                <InputText class="form-control" @bind-Value="_form.Cor" />
            </div>
            <div style="width:110px">
                <label class="form-label small mb-0">Odômetro</label>
                <InputNumber class="form-control" @bind-Value="_form.OdometroAtual" />
            </div>
            @if (_editingId is not null)
            {
                <div style="width:140px">
                    <label class="form-label small mb-0">Status</label>
                    <InputSelect class="form-select" @bind-Value="_form.Status">
                        @foreach (var status in Enum.GetValues<VehicleStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
            }
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_loading">@(_editingId is null ? "Adicionar" : "Salvar")</button>
                @if (_editingId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </div>
    </EditForm>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_vehicles is null)
    {
        <p>Carregando...</p>
    }
    else if (_vehicles.Count == 0)
    {
        <p>Nenhum veículo cadastrado ainda.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Marca/Modelo</th>
                    <th>Ano</th>
                    <th>Cor</th>
                    <th>Odômetro</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in _vehicles)
                {
                    <tr>
                        <td>@vehicle.Placa</td>
                        <td>@vehicle.Marca @vehicle.Modelo</td>
                        <td>@vehicle.Ano</td>
                        <td>@vehicle.Cor</td>
                        <td>@vehicle.OdometroAtual km</td>
                        <td>@vehicle.Status</td>
                        <td class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(vehicle)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDeleteAsync(vehicle)">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<VehicleDto>? _vehicles;
    private string? _error;
    private bool _loading;
    private Guid? _editingId;
    private readonly VehicleFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadVehiclesAsync();
    }

    private async Task LoadVehiclesAsync()
    {
        try
        {
            _vehicles = (await Api.GetVehiclesAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar os veículos.";
            _vehicles = [];
        }
    }

    private void StartEdit(VehicleDto vehicle)
    {
        _editingId = vehicle.Id;
        _form.Placa = vehicle.Placa;
        _form.Marca = vehicle.Marca;
        _form.Modelo = vehicle.Modelo;
        _form.Ano = vehicle.Ano;
        _form.Cor = vehicle.Cor;
        _form.OdometroAtual = vehicle.OdometroAtual;
        _form.Status = vehicle.Status;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        ResetForm();
    }

    private async Task HandleSubmitAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_editingId is { } id)
            {
                var updateRequest = new UpdateVehicleRequest(
                    _form.Placa, _form.Marca, _form.Modelo, _form.Ano, _form.Cor, _form.OdometroAtual, _form.Status);
                await Api.UpdateVehicleAsync(id, updateRequest);
                _editingId = null;
            }
            else
            {
                var createRequest = new CreateVehicleRequest(
                    _form.Placa, _form.Marca, _form.Modelo, _form.Ano, _form.Cor, _form.OdometroAtual);
                await Api.CreateVehicleAsync(createRequest);
            }

            ResetForm();
            await LoadVehiclesAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = $"Não foi possível salvar o veículo: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleDeleteAsync(VehicleDto vehicle)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Remover o veículo {vehicle.Placa} ({vehicle.Marca} {vehicle.Modelo})?");
        if (!confirmado)
            return;

        try
        {
            await Api.DeleteVehicleAsync(vehicle.Id);
            await LoadVehiclesAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível remover o veículo.";
        }
    }

    private void ResetForm()
    {
        _form.Placa = string.Empty;
        _form.Marca = string.Empty;
        _form.Modelo = string.Empty;
        _form.Ano = DateTime.Now.Year;
        _form.Cor = null;
        _form.OdometroAtual = 0;
        _form.Status = VehicleStatus.Disponivel;
    }

    private class VehicleFormModel
    {
        public string Placa { get; set; } = string.Empty;
        public string Marca { get; set; } = string.Empty;
        public string Modelo { get; set; } = string.Empty;
        public int Ano { get; set; } = DateTime.Now.Year;
        public string? Cor { get; set; }
        public int OdometroAtual { get; set; }
        public VehicleStatus Status { get; set; } = VehicleStatus.Disponivel;
    }
}
