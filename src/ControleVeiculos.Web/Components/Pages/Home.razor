@page "/"
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Controle de Veículos</PageTitle>

<div class="loading-block"><span class="spinner"></span> Abrindo...</div>

@code {
    protected override void OnInitialized()
    {
        if (!AuthState.IsAuthenticated)
            Nav.NavigateTo("/login");
        else if (AuthState.IsInRole("Motorista"))
            Nav.NavigateTo("/motorista/uso");
        else
            Nav.NavigateTo("/usos");
    }
}
