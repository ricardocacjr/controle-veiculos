@using ControleVeiculos.Domain.Enums
@using ControleVeiculos.Shared.UsageRecords
@inject ControleVeiculosApiClient Api
@inject Localizacao Localizacao
@inject BaseOperacional Base
@inject IJSRuntime JS

<button type="button" class="back-link" @onclick="Voltar"><Icon Name="chevron-left" Size="18" /> @(_passo == 1 ? "Cancelar" : "Voltar")</button>
<Passos Atual="_passo" Total="2" />

@if (_passo == 1)
{
    <h1 class="step-title">Foto do painel na chegada</h1>
    @if (!_fotoLida)
    {
        <CameraGrande Titulo="Fotografar o painel" Subtitulo="Mostrando o km. O app lê o número sozinho."
                      TextoOcupado="Lendo o painel..." Url="@($"api/usagerecords/{Uso.Id}/fotos")" Campos="CamposFoto"
                      Localizacao="true" OnInicio="() => _erro = null" OnResultado="PainelLidoAsync" />
        <Mensagens Erro="@_erro" />
        <button type="button" class="link-discreto border-0 bg-transparent w-100" @onclick="DigitarSemFotoAsync">Sem câmera? Digitar o km</button>
    }
    else
    {
        <div class="reading-card">
            <div class="reading-label">Km do painel</div>
            @if (_corrigindoKm)
            {
                @if (_semFoto)
                {
                    <div class="notice notice-info">Digite o km que aparece no painel. Sem a foto, o administrador vai conferir esse número.</div>
                }
                else if (_kmNaoLido)
                {
                    <div class="notice notice-info">Não consegui ler o número. Digite o km:</div>
                }
                <input class="form-control km-input" type="number" inputmode="numeric" @bind="_km" @bind:event="oninput" />
            }
            else
            {
                <div class="d-flex align-items-end justify-content-between gap-2">
                    <div class="km-display">@_km.Value.ToString("N0") <small>km</small></div>
                    <button type="button" class="btn btn-soft" @onclick="() => _corrigindoKm = true"><Icon Name="pencil" Size="16" /> Corrigir</button>
                </div>
            }
            @if (AvisoKm is { } aviso)
            {
                <div class="notice notice-error mt-3 mb-0">@aviso</div>
            }
        </div>

        <div class="reading-card">
            <div class="reading-label">Onde o carro ficou</div>
            @if (_posicao is { Ok: true } p && !_naBase)
            {
                <div class="notice notice-info">Você está a @DistanciaTexto(p) da @Base.Endereco.</div>
            }
            <LocalLido NaBase="_naBase" Endereco="@_enderecoGps" Posicao="_posicao" />
            @if (_posicao?.Ok != true)
            {
                <button type="button" class="btn btn-soft btn-app mt-2" disabled="@_buscandoLocal" @onclick="TentarGpsAsync"><Icon Name="pin" Size="18" /> Tentar pegar o local de novo</button>
            }
        </div>

        <button type="button" class="btn btn-primary btn-app big mt-3" disabled="@(_km is null || _km < Uso.OdometroInicial)" @onclick="() => _passo = 2">
            Continuar <Icon Name="chevron-right" Size="20" />
        </button>
        <button type="button" class="btn btn-soft btn-app mt-2" @onclick="() => { _fotoLida = false; _semFoto = false; }">
            <Icon Name="camera" Size="18" /> @(_semFoto ? "Tirar a foto" : "Tirar outra foto")
        </button>
    }
}
else
{
    <h1 class="step-title">Finalizar o percurso?</h1>
    <div class="reading-card">
        <div class="summary-row">
            <Icon Name="car" Class="summary-icon" />
            <span><span class="summary-key">Veículo</span><span class="summary-value">@Uso.VeiculoPlaca</span></span>
        </div>
        <div class="summary-row">
            <Icon Name="gauge" Class="summary-icon" />
            <span><span class="summary-key">Km</span><span class="summary-value">@Uso.OdometroInicial.ToString("N0") → @_km?.ToString("N0")</span></span>
        </div>
        <div class="summary-row">
            <Icon Name="flag" Class="summary-icon" />
            <span><span class="summary-key">Você rodou</span><span class="summary-value">@((_km - Uso.OdometroInicial)?.ToString("N0")) km</span></span>
        </div>
        <div class="summary-row">
            <Icon Name="pin" Class="summary-icon" />
            <span><span class="summary-key">Ficou em</span><span class="summary-value">@(!string.IsNullOrWhiteSpace(_localChegada) ? _localChegada : "Não informado")</span></span>
        </div>
        <div class="summary-row">
            <Icon Name="clock" Class="summary-icon" />
            <span><span class="summary-key">Tempo fora</span><span class="summary-value">@Rotulos.Duracao(Uso.IniciadoEm).Replace("há ", "")</span></span>
        </div>
    </div>
    <Mensagens Erro="@_erro" />
    <button type="button" class="btn btn-go btn-app mt-3" disabled="@_salvando" @onclick="FinalizarAsync">
        @if (_salvando)
        {
            <span class="spinner"></span><span>Finalizando...</span>
        }
        else
        {
            <Icon Name="flag" Size="24" /><span>FINALIZAR PERCURSO</span>
        }
    </button>
}

@code {
    [Parameter, EditorRequired] public UsageRecordDto Uso { get; set; } = default!;
    [Parameter] public UsageRecordDetailDto? Detalhe { get; set; }
    [Parameter] public EventCallback OnFechar { get; set; }
    [Parameter] public EventCallback<string> OnFinalizado { get; set; }

    private int _passo = 1;
    private bool _salvando;
    private bool _fotoLida;
    private bool _semFoto;
    // Campo de km aberto: fica aberto enquanto a pessoa digita (antes a condição era "km vazio",
    // e o campo sumia logo no 1º dígito).
    private bool _corrigindoKm;
    private bool _kmNaoLido;
    private int? _km;
    private Posicao? _posicao;
    private string? _erro;

    private string? AvisoKm =>
        _km is { } km && km < Uso.OdometroInicial
            ? $"O km final não pode ser menor que o da saída ({Uso.OdometroInicial:N0} km)."
            : _km is { } km2 && km2 - Uso.OdometroInicial > 1000
                ? $"São {km2 - Uso.OdometroInicial:N0} km rodados — confira se o número está certo."
                : null;

    private string DistanciaTexto(Posicao p)
    {
        var metros = Base.DistanciaMetros(p.Lat!.Value, p.Lng!.Value);
        return metros >= 1000 ? $"{metros / 1000:N1} km" : $"{metros:N0} m";
    }

    private async Task Voltar()
    {
        if (_passo == 1)
            await OnFechar.InvokeAsync();
        else
            _passo = 1;
    }

    // Sobe como foto do uso (tipo OdometroFinal): o servidor exige essa foto pra finalizar e já lê
    // o km usando o km de saída como referência.
    private static readonly IReadOnlyDictionary<string, string?> CamposFoto = new Dictionary<string, string?>
    {
        ["tipo"] = nameof(VehiclePhotoType.OdometroFinal),
    };

    private async Task PainelLidoAsync(ResultadoEnvio resultado)
    {
        if (!resultado.Ok)
        {
            _erro = $"Não consegui enviar a foto: {resultado.Mensagem}";
            return;
        }

        _km = resultado.Ler<VehiclePhotoDto>()?.OdometroLido;
        _fotoLida = true;
        _kmNaoLido = _km is null;
        _corrigindoKm = _kmNaoLido;
        try { await JS.InvokeVoidAsync("cvVibrar", 40); } catch (JSException) { }
        // Sem GPS junto com a foto (iPhone logo depois da câmera): tenta de novo agora.
        await DefinirLocalAsync(resultado.Posicao.Ok ? resultado.Posicao : await Localizacao.ObterAsync());
    }

    private async Task DigitarSemFotoAsync()
    {
        _erro = null;
        _semFoto = true;
        _km = null;
        _kmNaoLido = true;
        _corrigindoKm = true;
        _fotoLida = true;
        await DefinirLocalAsync(await Localizacao.ObterAsync());
    }

    private bool _naBase;
    private string? _enderecoGps;
    private string? _localChegada;
    private bool _buscandoLocal;

    private async Task TentarGpsAsync()
    {
        _buscandoLocal = true;
        try { await DefinirLocalAsync(await Localizacao.ObterAsync()); }
        finally { _buscandoLocal = false; }
    }

    /// <summary>Onde o carro ficou, só pelo GPS: na base → "Base - endereço"; fora → endereço do GPS.</summary>
    private async Task DefinirLocalAsync(Posicao posicao)
    {
        _posicao = posicao;
        _naBase = posicao.Ok && Base.EstaNaBase(posicao.Lat!.Value, posicao.Lng!.Value);
        _enderecoGps = !_naBase && posicao.Ok ? await Localizacao.EnderecoAsync(posicao.Lat!.Value, posicao.Lng!.Value) : null;
        _localChegada = _naBase ? Base.Endereco : _enderecoGps;
    }

    private async Task FinalizarAsync()
    {
        if (_km is null)
            return;

        _salvando = true;
        _erro = null;
        try
        {
            await Api.FinalizarUsoAsync(Uso.Id, _km.Value, _semFoto, _localChegada, _posicao?.Lat, _posicao?.Lng);
            await JS.InvokeVoidAsync("cvVibrar", new[] { 80, 60, 80 });
            await OnFinalizado.InvokeAsync($"Você rodou {_km.Value - Uso.OdometroInicial:N0} km.");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _erro = $"Não foi possível finalizar: {ex.Message}";
        }
        finally
        {
            _salvando = false;
        }
    }
}
