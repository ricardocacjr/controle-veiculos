<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControleVeiculos.Mobile.Pages.TripPage"
             Title="Uso em andamento">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label x:Name="ResumoLabel" FontSize="16" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" />

            <Label Text="Fotos" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="📷 Odômetro" Clicked="OnFotoOdometroClicked" />
                <Button Grid.Column="1" Text="📷 Avaria" Clicked="OnFotoAvariaClicked" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="LightGray" />

            <Label Text="Nota de voz" FontAttributes="Bold" />
            <Button x:Name="GravarButton" Text="🎙️ Gravar nota de voz" Clicked="OnGravarClicked" />
            <Label x:Name="GravandoLabel" Text="Gravando... toque novamente para parar" IsVisible="False" TextColor="Red" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" />

            <Label Text="Abastecimento" FontAttributes="Bold" />
            <Entry x:Name="LitrosEntry" Placeholder="Litros" Keyboard="Numeric" />
            <Entry x:Name="ValorEntry" Placeholder="Valor total (R$)" Keyboard="Numeric" />
            <Entry x:Name="OdometroAbastecimentoEntry" Placeholder="Odômetro no abastecimento" Keyboard="Numeric" />
            <Button Text="Registrar abastecimento" Clicked="OnAbastecimentoClicked" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" />

            <Label Text="Finalizar uso" FontAttributes="Bold" />
            <Entry x:Name="OdometroFinalEntry" Placeholder="Odômetro final" Keyboard="Numeric" />
            <Button Text="Finalizar uso" Clicked="OnFinalizarClicked" BackgroundColor="DarkRed" TextColor="White" />

            <Label x:Name="StatusLabel" TextColor="Green" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
            <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
