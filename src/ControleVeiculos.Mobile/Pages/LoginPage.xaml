<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControleVeiculos.Mobile.Pages.LoginPage"
             Title="Entrar">
    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label Text="Controle de Veículos" FontSize="24" HorizontalOptions="Center" />

        <Entry x:Name="EmailEntry" Placeholder="Usuário ou e-mail" />
        <Entry x:Name="PasswordEntry" Placeholder="Senha" IsPassword="True" />

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />

        <Button Text="Entrar" Clicked="OnLoginClicked" x:Name="LoginButton" />
        <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" />
    </VerticalStackLayout>
</ContentPage>
